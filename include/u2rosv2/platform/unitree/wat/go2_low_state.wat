;; Go2 buffer.read envelope and driver.result from the pinned attachment contract.
(module
  (memory $private (export "memory") 1 1)
  (func $encode (export "encode_read") (param $sequence i64) (param $deadline_ns i64)
        (param $out i32) (param $capacity i32) (result i32)
    (if (i32.lt_u (local.get $capacity) (i32.const 48)) (then (return (i32.const 0))))
    (i64.store (local.get $out) (local.get $sequence))
    (i64.store offset=8 (local.get $out) (local.get $deadline_ns))
    (i64.store offset=16 (local.get $out) (i64.const 24))
    (i64.store offset=24 (local.get $out) (i64.const 1))
    (i64.store offset=32 (local.get $out) (i64.const 0))
    (i64.store offset=40 (local.get $out) (i64.const 16))
    (i32.const 1))
  ;; On success, write the u32 tick followed by the f32 position to the caller's 8-byte output.
  (func $decode (export "decode_result") (param $frame i32) (param $size i32) (param $out i32) (result i32)
    (local $tick i64) (local $bits i64)
    (if (i32.ne (local.get $size) (i32.const 40)) (then (return (i32.const 0))))
    (if (i64.ne (i64.load (local.get $frame)) (i64.const 0)) (then (return (i32.const 0))))
    (if (i64.ne (i64.load offset=8 (local.get $frame)) (i64.const 24)) (then (return (i32.const 0))))
    (if (i64.ne (i64.load offset=16 (local.get $frame)) (i64.const 16)) (then (return (i32.const 0))))
    (local.set $tick (i64.load offset=24 (local.get $frame)))
    (local.set $bits (i64.load offset=32 (local.get $frame)))
    (if (i64.gt_u (i64.or (local.get $tick) (local.get $bits)) (i64.const 0xffffffff)) (then (return (i32.const 0))))
    (if (i64.eq (i64.and (local.get $bits) (i64.const 0x7f800000)) (i64.const 0x7f800000)) (then (return (i32.const 0))))
    (i64.store32 (local.get $out) (local.get $tick))
    (i64.store32 offset=4 (local.get $out) (local.get $bits))
    (i32.const 1))
)
