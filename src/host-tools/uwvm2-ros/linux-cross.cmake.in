set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR @processor@)
set(CMAKE_SYSROOT @sysroot@)
set(CMAKE_C_COMPILER @cc@)
set(CMAKE_CXX_COMPILER @cxx@)
set(CMAKE_ASM_COMPILER @cc@)
foreach(language C CXX ASM)
    set(CMAKE_${language}_COMPILER_TARGET @triple@)
    set(CMAKE_${language}_FLAGS_INIT @compile_flags@)
endforeach()
set(CMAKE_EXE_LINKER_FLAGS_INIT @link_flags@)
set(CMAKE_SHARED_LINKER_FLAGS_INIT @link_flags@)
set(LLVM_HOST_TRIPLE @triple@ CACHE STRING "VM host triple" FORCE)
set(LLVM_DEFAULT_TARGET_TRIPLE @triple@ CACHE STRING "VM code generation triple" FORCE)
set(LLVM_NATIVE_TOOL_DIR @native_bin@ CACHE PATH "Build-host table generators" FORCE)
set(LLVM_TABLEGEN @tablegen@ CACHE FILEPATH "Build-host table generator" FORCE)
set(CMAKE_FIND_ROOT_PATH @sysroot@)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
