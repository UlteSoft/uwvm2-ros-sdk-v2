;; PTR is the native C pointer carrier, i32 or i64. This adapter has no memory.
(module
  (import "a" "public_read" (func $a_pr (result i32)))
  (import "a" "public_write" (func $a_pw (param i32)))
  (import "b" "public_read" (func $b_pr (result i32)))
  (import "b" "public_write" (func $b_pw (param i32)))
  (import "a" "prepare" (func $a_prepare (result PTR)))
  (import "b" "prepare" (func $b_prepare (result PTR)))
  (import "a" "read_byte" (func $a_read (param PTR) (result i32)))
  (import "a" "write_byte" (func $a_write (param PTR i32)))
  (import "b" "read_byte" (func $b_read (param PTR) (result i32)))
  (import "b" "write_byte" (func $b_write (param PTR i32)))
  (import "a" "advance" (func $a_advance (param PTR) (result PTR)))
  (import "b" "advance" (func $b_advance (param PTR) (result PTR)))
  (import "a" "publish" (func $a_publish (param PTR)))
  (import "a" "consume" (func $a_consume (result PTR)))
  (import "b" "publish" (func $b_publish (param PTR)))
  (import "b" "consume" (func $b_consume (result PTR)))
  (import "b" "peer_raw" (func $b_raw (result PTR)))
  (import "a" "tag_public_pointer" (func $a_tag_public (result PTR)))

  (func $check (param $ok i32) (if (i32.eqz (local.get $ok)) (then unreachable)))
  (func $interior (param $p PTR) (result PTR) (PTR.add (local.get $p) (PTR.const 3)))

  (func (export "raw-offset")
    (call $a_pw (i32.const 91))
    (call $check (i32.eq (call $b_pr) (i32.const 91)))
    (call $b_pw (i32.const 173))
    (call $check (i32.eq (call $a_pr) (i32.const 173))))

  (func (export "pointer-call") (param $expected_a PTR) (param $expected_b PTR)
    (local $p PTR) (local $q PTR)
    (local.set $p (call $a_prepare))
    (call $check (PTR.eq (local.get $p) (local.get $expected_a)))
    (call $a_write (local.get $p) (i32.const 132))
    (call $check (i32.eq (call $b_read (local.get $p)) (i32.const 132)))
    (local.set $q (call $b_advance (local.get $p)))
    (call $check (PTR.eq (local.get $q) (call $interior (local.get $expected_a))))
    (call $b_write (local.get $q) (i32.const 71))
    (call $check (i32.eq (call $a_read (local.get $q)) (i32.const 71)))

    (local.set $p (call $b_prepare))
    (call $check (PTR.eq (local.get $p) (local.get $expected_b)))
    (call $b_write (local.get $p) (i32.const 23))
    (call $check (i32.eq (call $a_read (local.get $p)) (i32.const 23)))
    (local.set $q (call $a_advance (local.get $p)))
    (call $check (PTR.eq (local.get $q) (call $interior (local.get $expected_b))))
    (call $a_write (local.get $q) (i32.const 207))
    (call $check (i32.eq (call $b_read (local.get $q)) (i32.const 207))))

  (func (export "pointer-slot") (param $expected_a PTR) (param $expected_b PTR)
    (local $p PTR)
    (call $a_publish (call $a_prepare))
    (local.set $p (call $b_consume))
    (call $check (PTR.eq (local.get $p) (local.get $expected_a)))
    (call $b_write (local.get $p) (i32.const 37))
    (call $check (i32.eq (call $a_read (call $a_consume)) (i32.const 37)))
    (call $b_publish (call $b_advance (call $b_prepare)))
    (local.set $p (call $a_consume))
    (call $check (PTR.eq (local.get $p) (call $interior (local.get $expected_b))))
    (call $a_write (local.get $p) (i32.const 227))
    (call $check (i32.eq (call $b_read (call $b_consume)) (i32.const 227))))

  (func (export "zero-fill") (param $base PTR) (param $expected PTR)
    (local $p PTR) (local $i PTR)
    (local.set $i (PTR.const -1))
    (loop $seed
      (call $b_write (PTR.add (local.get $base) (local.get $i)) (i32.const 123))
      (local.set $i (PTR.add (local.get $i) (PTR.const 1)))
      (br_if $seed (PTR.ne (local.get $i) (PTR.const 17))))
    (local.set $p (call $a_prepare))
    (call $check (PTR.eq (local.get $p) (local.get $expected)))
    (local.set $i (PTR.const 0))
    (loop $verify
      (call $check (i32.eqz (call $b_read (PTR.add (local.get $p) (local.get $i)))))
      (local.set $i (PTR.add (local.get $i) (PTR.const 1)))
      (br_if $verify (PTR.ne (local.get $i) (PTR.const 16))))
    (call $check (i32.eq (call $b_read (PTR.sub (local.get $base) (PTR.const 1))) (i32.const 123)))
    (call $check (i32.eq (call $b_read (PTR.add (local.get $base) (PTR.const 16))) (i32.const 123))))

  (func (export "zero-pointer") (param $expected PTR) (param $store i32)
    (local $p PTR) (local $raw PTR)
    (local.set $p (call $a_prepare))
    (call $check (PTR.eq (local.get $p) (local.get $expected)))
    (local.set $p (call $interior (local.get $p)))
    (call $a_write (local.get $p) (i32.const 115))
    (local.set $raw (call $b_raw))
    (if (local.get $store)
      (then (call $b_write (local.get $raw) (i32.const 204))
            (call $check (i32.eq (call $a_read (local.get $p)) (i32.const 204))))
      (else (call $check (i32.eq (call $b_read (local.get $raw)) (i32.const 115))))))

  (func (export "zero-allocation") (param $expected PTR) (param $store i32)
    (local $p PTR)
    (call $a_pw (i32.const 83))
    (local.set $p (call $a_tag_public))
    (call $check (PTR.eq (local.get $p) (local.get $expected)))
    (if (local.get $store)
      (then (call $b_write (local.get $p) (i32.const 162))
            (call $check (i32.eq (call $a_pr) (i32.const 162))))
      (else (call $check (i32.eq (call $b_read (local.get $p)) (i32.const 83)))))))
