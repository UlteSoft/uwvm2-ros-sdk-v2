+		// Keyed by the first granule, protected by resizingMutex.
+		std::map<Uptr, WROSExtent> wrosExtents;
 		Uptr numReservedBytes = 0;
 
 		mutable Platform::RWMutex resizingMutex;
diff --git a/Lib/Runtime/WROSOwnership.cpp b/Lib/Runtime/WROSOwnership.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d4df81f703924bb04e588cecb7c5053871abd16b
--- /dev/null
+++ b/Lib/Runtime/WROSOwnership.cpp
@@ -0,0 +1,277 @@
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <new>
+#include "RuntimePrivate.h"
+#include "WAVM/IR/IR.h"
+#include "WAVM/IR/Operators.h"
+#include "WAVM/Inline/LEB128.h"
+#include "WAVM/Platform/Random.h"
+
+using namespace WAVM;
+using namespace WAVM::IR;
+using namespace WAVM::Runtime;
+
+namespace {
+using Counts = std::array<Uptr, 256>;
+using Directory = std::map<Uptr, WROSExtent>;
+constexpr Uptr granuleBytes = 16;
+constexpr Uptr reach = 1 + 64 / granuleBytes;
+
+[[noreturn]] void invalidTag() { throwException(ExceptionTypes::invalidMemoryTagAccess); }
+
+Uptr memorySize(const Memory& memory)
+{ return memory.numPages.load(std::memory_order_acquire) * IR::numBytesPerPage; }
+
+void checkRange(Memory& memory, Uptr address, Uptr length)
+{
+	const Uptr size = memorySize(memory);
+	if(address > size || length > size - address)
+	{ throwException(ExceptionTypes::outOfBoundsMemoryAccess, {&memory, U64(std::max(address, size))}); }
+}
+
+template<typename Visit>
+void visitDirectory(const Directory& directory, Uptr first, Uptr last, Visit visit)
+{
+	const Uptr low = first > reach ? first - reach : 0;
+	const Uptr high = last + reach;
+	auto entry = directory.lower_bound(low);
+	if(entry != directory.begin()) { --entry; }
+	for(; entry != directory.end() && entry->first <= high; ++entry)
+	{
+		if(entry->second.lastGranule >= low) { visit(entry->first, entry->second); }
+	}
+}
+
+void checkShadow(const Memory& memory, Uptr first, Uptr last, U8 expected)
+{
+	for(Uptr i = first; i <= last; ++i)
+	{ if(memory.baseAddressTags[i] != expected) { invalidTag(); } }
+}
+
+void fillShadow(Memory& memory, Uptr first, Uptr last, U8 tag)
+{ std::memset(memory.baseAddressTags + first, tag, last - first + 1); }
+
+U16 randomWord()
+{
+	// Refill from the OS instead of cycling through a fixed compartment-wide table.
+	static thread_local std::array<U16, 256> buffer;
+	static thread_local Uptr cursor = buffer.size();
+	if(cursor == buffer.size())
+	{
+		Platform::getCryptographicRNG(reinterpret_cast<U8*>(buffer.data()), sizeof(buffer));
+		cursor = 0;
+	}
+	return buffer[cursor++];
+}
+
+U8 chooseTag(const Memory& memory, const Directory& directory, Uptr first, Uptr last,
+			 const Counts* staticCounts)
+{
+	std::array<bool, 256> excluded{};
+	excluded[0] = true;
+	visitDirectory(directory, first, last, [&](Uptr start, const WROSExtent& extent) {
+		if(start <= last && extent.lastGranule >= first) { invalidTag(); }
+		excluded[extent.tag] = true;
+	});
+	const Uptr granules = memorySize(memory) / granuleBytes;
+	for(Uptr i = 1; i <= reach; ++i)
+	{
+		if(i <= first) { excluded[memory.baseAddressTags[first - i]] = true; }
+		if(i < granules - last) { excluded[memory.baseAddressTags[last + i]] = true; }
+	}
+
+	const unsigned maxTag = memory.indexType == IndexType::i32 ? 15 : 255;
+	std::array<U8, 255> legal;
+	unsigned numLegal = 0;
+	Uptr leastUsed = UINTPTR_MAX;
+	for(unsigned color = 1; color <= maxTag; ++color)
+	{
+		if(excluded[color]) { continue; }
+		const Uptr used = staticCounts ? (*staticCounts)[color] : 0;
+		if(used < leastUsed) { leastUsed = used; numLegal = 0; }
+		if(used == leastUsed) { legal[numLegal++] = U8(color); }
+	}
+	if(!numLegal) { invalidTag(); }
+	const unsigned attempts = staticCounts ? 8 : 16;
+	for(unsigned i = 0; i < attempts; ++i)
+	{
+		const U32 product = U32(randomWord()) * numLegal;
+		if((product & 0xffff) >= 65536u % numLegal) { return legal[product >> 16]; }
+	}
+	invalidTag();
+}
+
+void addExtent(Directory& directory, Uptr first, WROSExtent extent)
+{
+	try { if(!directory.emplace(first, extent).second) { invalidTag(); } }
+	catch(const std::bad_alloc&) { throwException(ExceptionTypes::outOfMemory); }
+}
+
+U64 transition(Memory& memory, Opcode op, U64 input, Uptr length)
+{
+	if(!memory.wrosOwnership || memory.isShared) { invalidTag(); }
+	if(!memory.baseAddressTags || LLVMJIT::is_memtagstatus_armmte(memory.memtagstatus)) { invalidTag(); }
+	const bool narrow = memory.indexType == IndexType::i32;
+	const unsigned shift = narrow ? memtag32constants::shifter : memtag64constants::shifter;
+	const Uptr address = input & (narrow ? memtag32constants::mask : memtag64constants::mask);
+	const U8 tag = U8(input >> shift);
+	checkRange(memory, address, length);
+	if(!length || (address % granuleBytes) || (length % granuleBytes)) { invalidTag(); }
+	const Uptr first = address / granuleBytes;
+	const Uptr last = (address + length - 1) / granuleBytes;
+	auto& directory = memory.wrosExtents;
+	if(op == Opcode::memtag_activate || op == Opcode::memtag_release)
+	{
+		auto found = directory.find(first);
+		if(found == directory.end()) { invalidTag(); }
+		WROSExtent& extent = found->second;
+		if(extent.lastGranule != last || extent.permanent || extent.tag != tag) { invalidTag(); }
+		checkShadow(memory, first, last, extent.active ? tag : 0);
+		if(op == Opcode::memtag_activate)
+		{
+			if(extent.active) { invalidTag(); }
+			fillShadow(memory, first, last, tag);
+			extent.active = true;
+			return input;
+		}
+		if(extent.active) { fillShadow(memory, first, last, 0); }
+		directory.erase(found);
+		return address;
+	}
+
+	if(tag || (op != Opcode::memtag_claim && op != Opcode::memtag_claimz && op != Opcode::memtag_reserve))
+	{ invalidTag(); }
+	checkShadow(memory, first, last, 0);
+	const U8 selected = chooseTag(memory, directory, first, last, nullptr);
+	const bool active = op != Opcode::memtag_reserve;
+	addExtent(directory, first, {last, selected, active, false});
+	if(active)
+	{
+		fillShadow(memory, first, last, selected);
+		if(op == Opcode::memtag_claimz) { std::memset(memory.baseAddress + address, 0, length); }
+	}
+	return address | (U64(selected) << shift);
+}
+
+struct StaticRange { U32 memoryIndex; Uptr first, last; };
+}
+
+WAVM_DEFINE_INTRINSIC_FUNCTION(wavmIntrinsicsMemory, "wros.transition", U64, wros_transition,
+							   U64 input, U64 length, U32 opcode, Uptr memoryId)
+{
+	Memory* memory = getMemoryFromRuntimeData(contextRuntimeData, memoryId);
+	Platform::RWMutex::ExclusiveLock lock(memory->resizingMutex);
+	return transition(*memory, Opcode(opcode), input, length);
+}
+
+WAVM_DEFINE_INTRINSIC_FUNCTION(wavmIntrinsicsMemory, "wros.clearDisabled", void, wros_clear_disabled,
+							   U64 address, U64 length, Uptr memoryId)
+{
+	Memory* memory = getMemoryFromRuntimeData(contextRuntimeData, memoryId);
+	Platform::RWMutex::ShareableLock lock(memory->resizingMutex);
+	if(!memory->wrosOwnership || memory->baseAddressTags || memory->isShared) { invalidTag(); }
+	checkRange(*memory, address, length);
+	if(length) { std::memset(memory->baseAddress + address, 0, length); }
+}
+
+WAVM_DEFINE_INTRINSIC_FUNCTION(wavmIntrinsicsMemory, "wros.checkSpan", void, wros_check_span,
+							   U64 address, U64 length, U32 tag, Uptr memoryId)
+{
+	Memory* memory = getMemoryFromRuntimeData(contextRuntimeData, memoryId);
+	Platform::RWMutex::ShareableLock lock(memory->resizingMutex);
+	if(!memory->wrosOwnership || !memory->baseAddressTags) { invalidTag(); }
+	checkRange(*memory, address, length);
+	if(length) { checkShadow(*memory, address / granuleBytes, (address + length - 1) / granuleBytes, U8(tag)); }
+}
+
+WAVM_DEFINE_INTRINSIC_FUNCTION(wavmIntrinsicsMemory, "wros.rawTagWrite", void, wros_raw_tag_write,
+							   U64 address, U64 length, U32 color, U32 zero, Uptr memoryId)
+{
+	Memory* memory = getMemoryFromRuntimeData(contextRuntimeData, memoryId);
+	Platform::RWMutex::ExclusiveLock lock(memory->resizingMutex);
+	if(!memory->wrosOwnership || memory->isShared || !memory->baseAddressTags) { invalidTag(); }
+	checkRange(*memory, address, length);
+	if(!length) { return; }
+	Uptr first = address / granuleBytes, last = (address + length - 1) / granuleBytes;
+	visitDirectory(memory->wrosExtents, first, last, [&](Uptr start, const WROSExtent& extent) {
+		if((start <= last && extent.lastGranule >= first) || extent.tag == color) { invalidTag(); }
+	});
+	fillShadow(*memory, first, last, U8(color));
+	if(zero) { std::memset(memory->baseAddress + address, 0, length); }
+}
+
+void Runtime::initializeWROSGlobals(const std::vector<Memory*>& memories, const IR::Module& module_)
+{
+	const CustomSection* manifest = nullptr;
+	for(const auto& section : module_.customSections)
+	{
+		if(section.name == "memtag.globals" && module_.featureSpec.wrosOwnership) { invalidTag(); }
+		if(section.name == "uwvm.memtag.linear.globals")
+		{
+			if(manifest || !module_.featureSpec.wrosOwnership) { invalidTag(); }
+			manifest = &section;
+		}
+	}
+	if(!manifest) { return; }
+	std::vector<StaticRange> ranges;
+	try
+	{
+		Serialization::MemoryInputStream in(manifest->data.data(), manifest->data.size());
+		U64 version, count;
+		Serialization::serializeVarUInt64(in, version);
+		Serialization::serializeVarUInt64(in, count);
+		if(version != 2 || count > in.capacity() / 3) { invalidTag(); }
+		ranges.reserve(count);
+		for(U64 i = 0; i < count; ++i)
+		{
+			U32 index;
+			U64 begin, bytes;
+			Serialization::serializeVarUInt32(in, index);
+			Serialization::serializeVarUInt64(in, begin);
+			Serialization::serializeVarUInt64(in, bytes);
+			if(index >= memories.size() || !memories[index]->wrosOwnership) { invalidTag(); }
+			checkRange(*memories[index], begin, bytes);
+			if(bytes) { ranges.push_back({index, begin / granuleBytes, (begin + bytes - 1) / granuleBytes}); }
+		}
+		if(in.capacity()) { invalidTag(); }
+	}
+	catch(const Serialization::FatalSerializationException&) { invalidTag(); }
+	catch(const std::bad_alloc&) { throwException(ExceptionTypes::outOfMemory); }
+
+	std::sort(ranges.begin(), ranges.end(), [](const StaticRange& a, const StaticRange& b) {
+		return a.memoryIndex < b.memoryIndex || (a.memoryIndex == b.memoryIndex && a.first < b.first);
+	});
+	for(Uptr i = 1; i < ranges.size(); ++i)
+	{
+		if(ranges[i - 1].memoryIndex == ranges[i].memoryIndex && ranges[i - 1].last >= ranges[i].first)
+		{ invalidTag(); }
+	}
+	// These owners are newly created and cannot be imported. Stage every allocation before
+	// publishing any tags. A late failure discards the staged directories.
+	try
+	{
+		std::vector<Directory> staged(memories.size());
+		Counts counts{};
+		U32 previous = UINT32_MAX;
+		for(const auto& row : ranges)
+		{
+			auto& memory = *memories[row.memoryIndex];
+			if(memory.memtagstatus == LLVMJIT::memtagStatus::none) { continue; }
+			if(!memory.baseAddressTags) { invalidTag(); }
+			if(previous != row.memoryIndex) { counts.fill(0); previous = row.memoryIndex; }
+			auto& directory = staged[row.memoryIndex];
+			const U8 tag = chooseTag(memory, directory, row.first, row.last, &counts);
+			addExtent(directory, row.first, {row.last, tag, true, true});
+			++counts[tag];
+		}
+		for(Uptr index = 0; index < staged.size(); ++index)
+		{
+			auto& memory = *memories[index];
+			memory.wrosExtents.swap(staged[index]);
+			for(const auto& item : memory.wrosExtents)
+			{ fillShadow(memory, item.first, item.second.lastGranule, item.second.tag); }
+		}
+	}
+	catch(const std::bad_alloc&) { throwException(ExceptionTypes::outOfMemory); }
+}
