+		context.push(input);
+		return;
+	}
+	auto& module = context.moduleContext;
+	auto result = context.emitRuntimeIntrinsic("wros.transition",
+		FunctionType(TypeTuple(ValueType::i64),
+					 {ValueType::i64, ValueType::i64, ValueType::i32, module.iptrValueType},
+					 CallingConvention::intrinsic),
+		{context.zext(input, context.llvmContext.i64Type),
+		 context.zext(length, context.llvmContext.i64Type), emitLiteral(context.llvmContext, U32(op)),
+		 getMemoryIdFromOffset(context.irBuilder, module.memoryOffsets[imm.memoryIndex])});
+	context.push(context.irBuilder.CreateZExtOrTrunc(result[0], input->getType()));
+}
