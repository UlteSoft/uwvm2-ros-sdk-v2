+static void emitWROSTransition(EmitFunctionContext& context, MemoryImm imm, Opcode op)
+{
+	auto* length = context.pop();
+	auto* input = context.pop();
+	if(!isMemTaggedEnabled(context))
+	{
+		// Disabled WROS ownership returns its input. claimz must also clear the proved range.
