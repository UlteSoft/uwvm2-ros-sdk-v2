+static void lowerX86ReturnCalls([[maybe_unused]] llvm::Module& llvmModule)
+{
+#if LLVM_VERSION_MAJOR == 23
+	for(auto& function : llvmModule)
+	{
+		if(function.getCallingConv() != llvm::CallingConv::Tail) { continue; }
+		for(auto& inst : llvm::instructions(function))
+		{
+			auto* call = llvm::dyn_cast<llvm::CallInst>(&inst);
+			if(!call || !call->isMustTailCall()) { continue; }
+
+			// LLVM 23's x86 backend treats musttail as a sibling call with stack
+			// arguments already in place. A tail-marked tailcc call in this position
+			// guarantees the jump and moves the arguments and return address as needed.
+			auto* ret = llvm::dyn_cast_or_null<llvm::ReturnInst>(call->getNextNode());
+			WAVM_ERROR_UNLESS(ret && ret->getReturnValue() == call);
+			WAVM_ERROR_UNLESS(call->getCallingConv() == llvm::CallingConv::Tail
+							  && !call->getFunctionType()->isVarArg() && !function.isVarArg());
+			call->setTailCallKind(llvm::CallInst::TCK_Tail);
+		}
+	}
+#endif
+}
