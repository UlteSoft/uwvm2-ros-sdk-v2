+#if LLVM_VERSION_MAJOR >= 13
+template<typename Mode> static constexpr auto jitDwarfUnwind(int) -> decltype(Mode::DwarfOnly)
+{ return Mode::DwarfOnly; }
+
+template<typename Mode> static constexpr Mode jitDwarfUnwind(...)
+{ return Mode::Always; }
+#endif
+
+template<typename Subtarget>
+static bool subtargetHasFeature(const Subtarget& subtarget, llvm::StringRef feature)
+{
+	if constexpr(std::is_pointer<Subtarget>::value)
+	{ return subtarget && subtarget->checkFeatures(feature); }
+	else { return subtarget.checkFeatures(feature); }
+}
