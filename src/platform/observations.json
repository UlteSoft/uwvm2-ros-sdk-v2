  "fourier": {
    "type": "simulator_pub_msg",
    "format": "lcm",
    "layout": [
      "i64 timestamp",
      "i32 motor_num",
      "f64[saved] q",
      "f64[saved] q_dot",
      "f64[3] acc",
      "f64[3] omega",
      "f64[4] quat",
      "f64 lf_touch",
      "f64 rf_touch",
      "f64[3] pos",
      "f64[3] vel"
    ],
    "read": {
      "timestamp": 4294967302,
      "q": -0.125,
      "q_dot": 0.5,
      "lf_touch": 0.25,
      "rf_touch": 0.75
    },
    "description": "Decode the complete Fourier Aurora MuJoCo simulator feedback message including its LCM fingerprint, signed motor count and big-endian joint and contact values.",
    "description_zh": "解码 Fourier Aurora MuJoCo 仿真反馈，包括 LCM 指纹、有符号电机数量以及大端编码的关节和接触值。",
    "sources": [
