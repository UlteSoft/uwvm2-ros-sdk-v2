  "boston_dynamics": {
    "type": "bosdyn.api.PointCloud.data",
    "format": "packed",
    "layout": [
      "f32[rest3] xyz"
    ],
    "read": {
      "x": {
        "field": "xyz",
        "step": 3,
        "base": 0,
        "value": -0.5
      },
      "y": {
        "field": "xyz",
        "step": 3,
        "base": 1,
        "value": 1.25
      },
      "z": {
        "field": "xyz",
        "step": 3,
        "base": 2,
        "value": 0.75
      }
    },
    "description": "Read the XYZ_32F data field of a Spot point cloud. Each point contains three consecutive little-endian float32s. Pass the extracted protobuf bytes field and a zero-based point index.",
    "description_zh": "读取 Spot 点云的 XYZ_32F 数据字段。每个点包含三个连续的小端 float32。传入已提取的 protobuf 字节字段和从零开始的点索引。",
    "sources": [
      {
        "url": "https://github.com/boston-dynamics/spot-sdk/blob/16a98aae3b818082288504c6e53b59a67666aaeb/protos/bosdyn/api/point_cloud.proto",
        "revision": "16a98aae3b818082288504c6e53b59a67666aaeb",
        "path": "protos/bosdyn/api/point_cloud.proto",
        "sha256": "5b6fa58ee76d528d19de90f6f63545a71ac7ecf108e9644c640248d89ff9fcb6"
      }
    ]
  },
  "clearpath": {
    "type": "clearpath_dock_msgs/DockState",
    "format": "ros1",
    "layout": [
      "u8 state"
    ],
    "read": {
      "state": 3
    },
    "description": "Read the docking state. The upstream enum assigns 1 to DOCKED and 3 to FAILED.",
    "description_zh": "读取充电座对接状态。上游枚举中 DOCKED 为 1，FAILED 为 3。",
    "sources": [
      {
        "url": "https://github.com/clearpathrobotics/clearpath_msgs/blob/c17b52e7ba7061310493b43d5b1cd4ffd33cc9b6/clearpath_outdoornav_msgs/clearpath_dock_msgs/msg/DockState.msg",
        "revision": "c17b52e7ba7061310493b43d5b1cd4ffd33cc9b6",
        "path": "clearpath_outdoornav_msgs/clearpath_dock_msgs/msg/DockState.msg",
        "sha256": "de991e17e3311d74dfd558af9edd045c62b490488a8d770d20d784119f80c6da"
      }
    ],
    "constants": {
      "UNDOCKED": 0,
      "DOCKED": 1,
      "IN_PROGRESS": 2,
      "FAILED": 3,
      "CANCELLED": 4
    }
  },
  "deep_robotics": {
    "type": "drdds/ImuDataValue",
