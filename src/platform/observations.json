      }
    ]
  },
  "agilex": {
    "type": "scout_msgs/ScoutBmsStatus",
    "format": "ros1",
    "layout": [
      "f64 soc",
      "f64 soh",
      "f64 battery_voltage",
      "f64 battery_current",
      "f64 battery_temperature",
      "u8 alarm_status_1",
      "u8 alarm_status_2",
      "u8 warning_status_1",
      "u8 warning_status_2"
    ],
    "read": {
      "soc": 73.5,
      "battery_voltage": 48.25,
