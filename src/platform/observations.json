  "booster": {
    "type": "booster_interface/ImuState",
    "format": "cdr",
    "layout": [
      "f32[3] rpy",
      "f32[3] gyro",
      "f32[3] acc"
    ],
    "read": {
      "rpy": 0.25,
      "gyro": -1.5,
