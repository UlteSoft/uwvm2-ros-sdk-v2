{
  "abb": {
    "type": "abb_rapid_msgs/Pos",
    "wire_modules": ["ros1"],
    "wire_summary": "C, C++ and Rust encode and decode 25 ABB ROS 1 messages, 22 service request/response pairs and the shared Header.",
    "wire_summary_zh": "C、C++ 和 Rust 可编解码 25 种 ABB ROS 1 消息、22 对服务请求与响应，以及公共的 Header。",
    "format": "ros1",
    "layout": [
      "f32 x",
      "f32 y",
      "f32 z"
    ],
    "read": {
      "x": 12.5,
      "y": -2.75,
      "z": 0.5
    },
    "description": "Read X, Y and Z from the ROS representation of a RAPID pos.",
    "description_zh": "读取 RAPID pos 在 ROS 消息中的 X、Y、Z 三个分量。",
    "sources": [
      {
        "url": "https://github.com/ros-industrial/abb_robot_driver_interfaces/blob/da809cd0bb6f270c0814fca07d7d4a5c0385fc39/abb_rapid_msgs/msg/Pos.msg",
        "revision": "da809cd0bb6f270c0814fca07d7d4a5c0385fc39",
        "path": "abb_rapid_msgs/msg/Pos.msg",
        "sha256": "feccb992c3b666d431efd20eb4f7cbef5fa5b921a5a95337656cff1e7735333f"
      }
    ]
  },
  "agibot": {
    "type": "aimdk_msgs/JointState",
    "format": "cdr",
    "layout": [
      "str name",
      "f64 position",
      "f64 velocity",
      "f64 effort",
      "u16 error_code"
    ],
    "read": {
      "position": 0.5,
      "velocity": -0.25,
      "effort": 1.75,
      "error_code": 257
    },
    "description": "Read joint feedback after the variable-length joint name. The final uint16 is the joint error code.",
    "description_zh": "跳过可变长度的关节名后读取位置、速度、力和末尾的 16 位错误码。",
    "sources": [
      {
