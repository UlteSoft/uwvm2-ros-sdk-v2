      }
    ]
  },
  "franka": {
    "type": "franka_msgs/Elbow",
    "format": "cdr",
    "wire_modules": ["cdr"],
    "wire_summary": "C, C++, Rust and Go (standard Go and TinyGo) encode and decode 137 ROS 2 XCDRv1 records for the Franka arm, gripper, spine and their standard dependencies.",
    "wire_summary_zh": "C、C++、Rust 和 Go（标准 Go 与 TinyGo）可编解码 137 个 ROS 2 XCDRv1 记录，覆盖 Franka 机械臂、夹爪、脊柱及其标准依赖。",
    "example_frames": "franka/elbow_fixtures.json",
    "layout": [
      "f64[2] position",
      "f64[2] desired_position",
      "f64[2] commanded_position",
      "f64[2] commanded_velocity",
      "f64[2] commanded_acceleration"
    ],
    "read": {
      "position": -1.0,
      "desired_position": 1.0,
      "commanded_position": -1.0,
      "commanded_velocity": -0.0625,
      "commanded_acceleration": -0.25
    },
    "description": "Read either component of all five elbow arrays and validate the complete record.",
    "description_zh": "读取肘部五个数组中任一分量，并校验完整记录。",
    "sources": [
      {
        "url": "https://github.com/frankarobotics/franka_ros2/blob/4acc05c01ebfcdf916ee6b3df966df0ad7b2f9ec/franka_msgs/msg/Elbow.msg",
