# Configure the upstream templates for the Linux-hosted wasm32 WASI Mono AOT test.
# Source tree and destination are absolute paths set by the caller.
foreach(name IN ITEMS
    DISABLE_DEBUGGER_AGENT
    DISABLE_ICALL_TABLES
    DISABLE_INTERPRETER
    DISABLE_JIT
    DISABLE_LOGGING
    DISABLE_LOG_DEST
    DISABLE_QCALLS
    DISABLE_SGEN_DEBUG_HELPERS
    DISABLE_SGEN_GC_BRIDGE
    DISABLE_SGEN_MAJOR_MARKSWEEP_CONC
    DISABLE_SGEN_SPLIT_NURSERY
    DISABLE_THREADS
    ENABLE_ICALL_EXPORT
    ENABLE_LLVM_RUNTIME
    ENABLE_WEBCIL
    HAVE_ALLOCA_H
    HAVE_CLOCKID_T
    HAVE_CLOCK_GETTIME
    HAVE_CLOCK_MONOTONIC
    HAVE_CLOCK_NANOSLEEP
    HAVE_CONC_GC_AS_DEFAULT
    HAVE_DECL_PTHREAD_MUTEXATTR_SETPROTOCOL
    HAVE_DLFCN_H
    HAVE_FTRUNCATE
    HAVE_GETENTROPY
    HAVE_GETOPT_H
    HAVE_LOCALTIME_R
    HAVE_LSTAT
    HAVE_MMAP
    HAVE_MOVING_COLLECTOR
    HAVE_NETDB_H
    HAVE_NETINET_IN_H
    HAVE_POLL
    HAVE_POLL_H
    HAVE_PTHREAD_ATTR_SETSTACKSIZE
    HAVE_PTHREAD_H
    HAVE_SEMAPHORE_H
    HAVE_STDINT_H
    HAVE_STRERROR_R
    HAVE_STRINGS_H
    HAVE_STRLCPY
    HAVE_STRNDUP
    HAVE_STRTOK_R
