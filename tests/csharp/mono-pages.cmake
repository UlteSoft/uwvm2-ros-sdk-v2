    HAVE_SYS_IOCTL_H
    HAVE_SYS_MMAN_H
    HAVE_SYS_PARAM_H
    HAVE_SYS_POLL_H
    HAVE_SYS_RANDOM_H
    HAVE_SYS_RESOURCE_H
    HAVE_SYS_SELECT_H
    HAVE_SYS_STAT_H
    HAVE_SYS_SYSCALL_H
    HAVE_SYS_TIME_H
    HAVE_SYS_TYPES_H
    HAVE_SYS_UTSNAME_H
    HAVE_TLS_MODEL_ATTR
    HAVE_UNISTD_H
    HAVE_UNWIND_H
    HAVE_VASPRINTF
    HAVE_VSNPRINTF
    HAVE_WCHAR_H
    HOST_WASI
    HOST_WASM
    INTERNAL_ZLIB
    LAZY_GC_THREAD_CREATION
