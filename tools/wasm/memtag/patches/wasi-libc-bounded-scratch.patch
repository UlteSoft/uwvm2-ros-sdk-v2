+static int ppoll_impl(struct pollfd *fds, size_t nfds,
+                      const struct timespec *timeout) {
+  // Every descriptor can require one read and one write subscription.
+  // Account for the optional clock separately before either multiplication.
+  size_t clock = timeout != NULL;
+  size_t max_count = SIZE_MAX / sizeof(__wasi_subscription_t);
+  if (SIZE_MAX / sizeof(__wasi_event_t) < max_count)
+    max_count = SIZE_MAX / sizeof(__wasi_event_t);
+  if (nfds > (max_count - clock) / 2) {
+    errno = ENOMEM;
+    return -1;
+  }
+  size_t count = nfds * 2 + clock;
+  if (count <= 17) {
+    __wasi_subscription_t subscriptions[17];
+    __wasi_event_t events[17];
+    return poll_with_buffers(fds, nfds, timeout, subscriptions, events);
+  }
+  __wasi_subscription_t *subscriptions = malloc(count * sizeof(*subscriptions));
+  if (!subscriptions)
+    return -1;
+  __wasi_event_t *events = malloc(count * sizeof(*events));
+  if (!events) {
+    free(subscriptions);
+    return -1;
+  }
+  int rc = poll_with_buffers(fds, nfds, timeout, subscriptions, events);
+  free(events);
+  free(subscriptions);
+  return rc;
 }
 
