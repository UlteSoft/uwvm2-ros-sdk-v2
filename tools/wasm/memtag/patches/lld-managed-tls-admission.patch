diff --git a/lld/wasm/Driver.cpp b/lld/wasm/Driver.cpp
--- a/lld/wasm/Driver.cpp
+++ b/lld/wasm/Driver.cpp
@@ -1526,7 +1526,15 @@
   if (errorCount())
     return;
 
-  // Write the result to the file.
+  // All input objects, including LTO results, have been resolved and live
+  // symbols are final. Refuse before opening or emitting the output file.
+  if (args.hasArg(OPT_require_managed_tls) && args.hasArg(OPT_allow_legacy_tagged_tls)) {
+    error("--require-managed-tls is incompatible with --allow-legacy-tagged-tls");
+    return;
+  }
+  if (!args.hasArg(OPT_allow_legacy_tagged_tls) && !ctx.arg.relocatable &&
+      ctx.arg.isMultithreaded() && !validateManagedTLS())
+    return;
   writeResult();
 }
 
diff --git a/lld/wasm/Writer.cpp b/lld/wasm/Writer.cpp
--- a/lld/wasm/Writer.cpp
+++ b/lld/wasm/Writer.cpp
@@ -2163,6 +2163,24 @@
   fileSize += header.size();
 }
 
+// Current wasi-libc can place TLS inside a tagged heap allocation or a user
+// stack. The linker cannot infer parent ownership, nor prove retire-on-join,
+// detach and failed spawn. Refuse when the final image actually needs this
+// contract. This must not depend on __wasm_init_tls being live or on !isPic.
+bool validateManagedTLS() {
+  for (InputFile *file : ctx.objectFiles)
+    for (Symbol *sym : file->getSymbols())
+      if (auto *data = dyn_cast<DefinedData>(sym))
+        if (data->isLive() && !data->isDiscarded() && data->segment &&
+            data->isTLS() && data->isMemtag() && data->getSize()) {
+          error("--require-managed-tls: live tagged thread-local object " +
+                toString(*data) + " requires a dedicated TLS allocation and "
+                "retirement contract");
+          return false;
+        }
+  return true;
+}
+
 void writeResult() { Writer().run(); }
 
 } // namespace lld::wasm
