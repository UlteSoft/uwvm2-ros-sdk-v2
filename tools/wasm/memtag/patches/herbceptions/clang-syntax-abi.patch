+/// to the checks below, so `try(f(x))` was rejected for any T with a
+/// non-trivial destructor -- a class with no destructor worked, one with a
+/// destructor did not.
+static const Expr *skipHerbceptionTemporaryWrappers(const Expr *Ex) {
+  for (;;) {
