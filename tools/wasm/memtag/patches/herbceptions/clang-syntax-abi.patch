index 0000000000000000000000000000000000000000..0bbf8c4530eb1200ff8d4edf3567621c87a808a0
--- /dev/null
+++ b/clang/test/CodeGen/herbceptions-autoprop.cpp
@@ -0,0 +1,29 @@
+// RUN: %clang -fherbceptions -fno-exceptions -S -fdiscard-value-names -emit-llvm -o - %s | FileCheck %s
+
+// In C++, a bare call to a throws function inside a throws function
+// auto-propagates the error (no explicit try() needed).
+
+// CHECK: define dso_local { i32, i1 } @_Z3barDEiEi(i32 noundef %0) #[[ATTR:[0-9]+]]
+int bar(int x) return_failure{int} {
+  if (x < 0) return_failure x;
+  return x + 1;
+}
+
+// CHECK-LABEL: define dso_local { i32, i1 } @_Z3fooDEiEi(i32 noundef %0)
+// CHECK:         call { i32, i1 } @_Z3barDEiEi
+// CHECK:         extractvalue { i32, i1 } %{{.*}}, 1
+// CHECK:         br i1 %{{.*}}, label %{{[0-9]+}}, label %{{[0-9]+}}
+int foo(int x) return_failure{int} {
+  return bar(x);  // bare call, auto-propagates
+}
+
+// A plain (non-throws) function cannot use auto-propagation: calling a fails
+// function bare must be handled explicitly with catch return_failure().
+// CHECK-LABEL: define dso_local noundef i32 @_Z6bazouri(i32 noundef %0)
+// CHECK:         %[[E:.*]] = alloca %struct.__herb_catch_fails, align 4
+int bazour(int x) {
+  auto e = catch return_failure(bar(x));
+  return !e.failed ? e.value : e.error;
+}
+
+// CHECK: attributes #[[ATTR]] = { {{.*}}herbthrows{{.*}} }
diff --git a/clang/test/CodeGen/herbceptions-catch-fails-indirect.cpp b/clang/test/CodeGen/herbceptions-catch-fails-indirect.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ac0c2d0e0692d86b5152a6081ff351d06ec46bf4
--- /dev/null
+++ b/clang/test/CodeGen/herbceptions-catch-fails-indirect.cpp
@@ -0,0 +1,28 @@
+// RUN: %clang -fherbceptions -fno-exceptions -S -fdiscard-value-names -emit-llvm -o - %s | FileCheck %s
+
+// Herbception `catch return_failure(expr)` with a payload that the ABI returns
+// indirectly. On Win64 a payload wider than the register budget is built in
+// caller storage behind a `herbthrows_sret` pointer, so the call returns {E, i1} and
+// the payload has to be read back out of that storage. The first element of the
+// returned aggregate is then the error alone, not the payload: taking the
+// payload from it silently yields the error and whatever follows it in memory.
+
+struct Big { long long a, b, c, d; };
+struct E2 { long long x, y; };
+
+// CHECK: define dso_local { %struct.E2, i1 } @_Z5mkbigDE2E2Ei(ptr noalias writable herbthrows_sret(%struct.Big) align 8 %{{.*}}, i32
+Big mkbig(int n) return_failure{E2} { return {n, n + 1, n + 2, n + 3}; }
+
+// CHECK-LABEL: define dso_local noundef i64 @_Z3fooi(i32 noundef %0)
+// CHECK:         %[[CALL:.*]] = call { %struct.E2, i1 } @_Z5mkbigDE2E2Ei(ptr {{.*}}herbthrows_sret(%struct.Big){{.*}} %[[SLOT:.*]], i32
+// The discriminant comes from the aggregate.
+// CHECK:         %[[DISC:.*]] = extractvalue { %struct.E2, i1 } %[[CALL]], 1
+// CHECK:         %[[ZF:.*]] = zext i1 %[[DISC]] to i8
+// The payload is read from the storage the callee was given, not from the
+// aggregate's first element (which holds the error).
+// CHECK:         %[[VAL:.*]] = load %struct.Big, ptr %[[SLOT]]
+// CHECK:         store %struct.Big %[[VAL]]
+long long foo(int x) {
+  auto e = catch return_failure(mkbig(x));
+  return !e.failed ? e.value.d : e.error.x;
+}
diff --git a/clang/test/CodeGen/herbceptions-catch-fails-nontrivial.cpp b/clang/test/CodeGen/herbceptions-catch-fails-nontrivial.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..07d7146ed89d1c1a18fe2dad0382b5b33586c296
--- /dev/null
+++ b/clang/test/CodeGen/herbceptions-catch-fails-nontrivial.cpp
@@ -0,0 +1,56 @@
+// RUN: %clang -fherbceptions -fno-exceptions -std=c++26 -S -emit-llvm -o - %s | FileCheck %s
+
+// A `catch return_failure(expr)` whose success type has a non-trivial
+// destructor must be accepted.
+//
+// Clang used to store the success/error members of the N2289 aggregate in an
+// anonymous union.  A C++ union with a non-trivial member has no implicit
+// destructor, so the enclosing `__herb_catch_fails` got an implicitly-deleted
+// destructor and binding the result failed with "attempt to use a deleted
+// function" ("destructor of '__herb_catch_fails' is implicitly deleted because
+// variant field 'value' has a non-trivial destructor").  That made `catch
+// return_failure` unusable for every RAII type (files, buffers, strings, ...).
+// The members are now stored side by side, matching GCC.
+//
+// The call also comes back wrapped in CXXBindTemporaryExpr (a non-trivial
+// return type owns a resource), so the callee lookup must skip those wrappers;
+// otherwise the error type is taken to be the success type and `r.error` has
+// the wrong type.
+
+struct T {
+  int v;
+  ~T() {}
+};
+struct E {
+  int e;
+};
+
+// The members are value/error/failed, in that order.  (Like any record with a
+// non-trivial member, the IR type is packed with explicit tail padding.)
+// A void success type still yields the three-member aggregate; GCC gives the
+// `value` member the error type in that case, and so do we (a real `void`
+// field would make the layout degenerate).
+// CHECK: %struct.__herb_catch_fails = type {{.*}}{ %struct.T, %struct.E, i8
+// CHECK: %struct.__herb_catch_fails{{.*}} = type {{.*}}%struct.E, %struct.E, i8
+
+// CHECK-LABEL: define {{.*}} @_Z1fDE1EEi
+T f(int n) return_failure{E} { return {n}; }
+
+// `r.error` must be E, not the success type T.
+// CHECK-LABEL: define {{.*}} @_Z1gi
+int g(int n) {
+  auto r = catch return_failure(f(n));
+  return !r.failed ? r.value.v : r.error.e;
+}
+
+// A void success type still yields the three-member aggregate; GCC gives the
+// `value` member the error type in that case, and so do we (a real `void`
+// field would make the layout degenerate).
+// CHECK-LABEL: define {{.*}} @_Z1vDE1EEv
+void v() return_failure{E} { return_failure E{1}; }
+
+// CHECK-LABEL: define {{.*}} @_Z1hv
+int h() {
+  auto r = catch return_failure(v());
+  return r.failed ? r.error.e : 0;
+}
diff --git a/clang/test/CodeGen/herbceptions-catch-fails.cpp b/clang/test/CodeGen/herbceptions-catch-fails.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..1dcf51c1bb5ed61e103034687e549a122130b212
--- /dev/null
+++ b/clang/test/CodeGen/herbceptions-catch-fails.cpp
@@ -0,0 +1,34 @@
+// RUN: %clang -fherbceptions -fno-exceptions -S -fdiscard-value-names -emit-llvm -o - %s | FileCheck %s
+
+// Herbception `catch return_failure(expr)`: the throws call returns {T, i1}, and the
+// expression builds the N2289 aggregate
+//   struct { T value; E error; bool failed; }
+// with .failed = discriminant and .value/.error sourced from the payload slot.
+// The members are side by side (not a union) so that a non-trivial success
+// type does not give the aggregate a deleted destructor.
+
+// CHECK: %struct.__herb_catch_fails = type { i32, i32, i8 }
+
+// A return_failure{int} function returns {i32, i1} with the 'throws' attribute.
+// CHECK: define dso_local { i32, i1 } @_Z3barDEiEi(i32 noundef %0) #[[ATTR:[0-9]+]]
+int bar(int x) return_failure{int} {
+  if (x < 0) return_failure x;
+  return x + 1;
+}
+
+// catch return_failure(bar(x)) extracts the discriminant and builds the aggregate.
+// CHECK-LABEL: define dso_local noundef i32 @_Z3fooi(i32 noundef %0)
+// CHECK:         %{{.*}} = call { i32, i1 } @_Z3barDEiEi
+// CHECK:         %{{.*}} = extractvalue { i32, i1 } %{{.*}}, 0
+// CHECK:         %{{.*}} = extractvalue { i32, i1 } %{{.*}}, 1
+// CHECK:         getelementptr inbounds nuw %struct.__herb_catch_fails, ptr %{{.*}}, i32 0, i32 2
+// CHECK:         %{{.*}} = zext i1 %{{.*}} to i8
+// CHECK:         store i8 %{{.*}}, ptr %{{.*}}, align 4
+// CHECK:         getelementptr inbounds nuw %struct.__herb_catch_fails, ptr %{{.*}}, i32 0, i32 0
+// CHECK:         store i32 %{{.*}}, ptr %{{.*}}, align 4
+int foo(int x) {
+  auto e = catch return_failure(bar(x));
+  return !e.failed ? e.value * 2 : e.error;
+}
+
+// CHECK: attributes #[[ATTR]] = { {{.*}}herbthrows{{.*}} }
diff --git a/clang/test/CodeGen/herbceptions-catch-throws-autoprop.cpp b/clang/test/CodeGen/herbceptions-catch-throws-autoprop.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..2d7d1a2f264f9503abb4295c0de05deab976c968
--- /dev/null
+++ b/clang/test/CodeGen/herbceptions-catch-throws-autoprop.cpp
@@ -0,0 +1,48 @@
+// RUN: %clang_cc1 -std=c++26 -fherbceptions -emit-llvm -o - %s | FileCheck %s
+
+// A bare call to a `throws` function inside a `try { } catch throws(...)`
+// block that is itself inside a `throws` function must route the error to the
+// enclosing catch handler, not auto-propagate it to the function's return
+// slot. Previously Sema auto-wrapped the bare call in a CXXTryExpr and
+// EmitHerbceptionTry always auto-propagated (stored to the return slot and
+// returned), which made the catch handler unreachable. The error path of the
+// auto-propagation must branch to the handler when one is active.
+
+namespace std {
+struct error {
+  void *domain;
+  __SIZE_TYPE__ code;
+  ~error() noexcept;
+};
+enum class errc : unsigned { io_error = 5 };
+template <typename T> class error_domain;
+template <> class error_domain<errc> {
+public:
+  static void *domain() noexcept;
+  static __SIZE_TYPE__ code(errc) noexcept;
+};
+} // namespace std
+
+// bar() throws a herbception (no legacy EH involved).
+void bar() throws {
+  throw throws ::std::errc::io_error;
+}
+
+// The catch handler must be reachable (have a predecessor) and run on the
+// error path.
+//
+// CHECK: define dso_local { { ptr, i64 }, i1 } @_Z8test_barDrv()
+// CHECK: call { { ptr, i64 }, i1 } @_Z3barDrv()
+// CHECK: br i1 %{{.*}}, label %try.err, label %try.ok
+// CHECK: try.err:
+// CHECK: br label %catch.throws
+// CHECK: catch.throws:
+// CHECK-SAME: ; preds = %try.err
+// CHECK: store %"struct.std::error" %{{.*}}, ptr %e, align 8
+// CHECK: br label %herb.try.cont
+
+void test_bar() throws try {
+  bar();
+} catch throws(std::error e) {
+  (void)e;
+}
diff --git a/clang/test/CodeGen/herbceptions-catch-throws.cpp b/clang/test/CodeGen/herbceptions-catch-throws.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..a85a25ec5ba7966dff5bee3b6e97edf9af574953
--- /dev/null
+++ b/clang/test/CodeGen/herbceptions-catch-throws.cpp
@@ -0,0 +1,39 @@
+// RUN: %clang -fherbceptions -S -fdiscard-value-names -emit-llvm -o - %s | FileCheck %s
+
+// Herbception `catch throws(E e) { ... }` block handler: a bare call to a
+// throws function inside the try block returns {T, i1}, and on failure the
+// error value is routed to the handler (which binds the exception variable)
+// instead of being silently dropped in a noexcept function.
+
+using size_t = __SIZE_TYPE__;
+
+namespace std {
+struct error {
+  void *domain;
+  __SIZE_TYPE__ code;
+  // The error value is a compiler-fabricated {domain, code} pair whose
+  // destructor (which runs the domain's do_cleanup) must execute exactly once
+  // when the catch variable goes out of scope, like std::expected.
+  ~error() noexcept;
+};
+}
+
+// CHECK: define dso_local void @_Z6calleem(i64 noundef %0) #[[ATTR:[0-9]+]] {
+// CHECK: call { { ptr, i64 }, i1 } @_Z3barDrm
+// CHECK: extractvalue { { ptr, i64 }, i1 } %{{.*}}, 1
+// CHECK: br i1 %{{.*}}, label %{{[0-9]+}}, label %{{[0-9]+}}
+// CHECK: store %"struct.std::error" %{{.*}}, ptr %{{.*}}, align 8
+// CHECK: call void @_ZNSt5errorD1Ev(ptr {{.*}} %{{.*}})
+void bar(size_t i) throws {
+  if (i == 0) throw throws std::error{nullptr, 4};
+}
+
+void callee(size_t i) noexcept {
+  try {
+    bar(i);
+  } catch throws(std::error e) {
+    (void)e.code;
+  }
+}
+
+// CHECK: attributes #[[ATTR]] = { {{.*}} }
diff --git a/clang/test/CodeGen/herbceptions-const-pure-attr.cpp b/clang/test/CodeGen/herbceptions-const-pure-attr.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b4a2bf1eb2c55215807b03235bf049f28dd5f970
--- /dev/null
+++ b/clang/test/CodeGen/herbceptions-const-pure-attr.cpp
@@ -0,0 +1,70 @@
+// RUN: %clang -std=c++20 -fherbceptions -fno-exceptions -S -fdiscard-value-names -emit-llvm -Werror -o - %s | FileCheck %s
+
+// 'const'/'pure' are honored on herbceptions functions: the failure
+// discriminant is part of the return value ({union{T,E}, i1}), so call
+// elision/dedup preserves it and the attributes remain sound. -Werror also
+// pins that no "attribute ignored" diagnostic is emitted.
+
+namespace std {
+struct error_domain_singleton {};
+struct error {
+  void *d;
+  __SIZE_TYPE__ c;
+};
+// `coff` below is a `return_failure{int}` callee auto-propagated into the
+// std::error channel of a `throws` function, which requires converting its
+// int payload through std::error_domain<int>.
+template <class T> class error_domain;
+template <> class error_domain<int> {
+public:
+  static error_domain_singleton *domain() noexcept;
+  static __SIZE_TYPE__ code(int) noexcept;
+};
+} // namespace std
+
+struct Big { long long a, b, c, d, e, f, g, h; }; // ABI-indirect payload
+
+__attribute__((const)) int cof(int x) throws;
+__attribute__((pure)) int puf(int x) throws;
+__attribute__((const)) int coff(int x) return_failure{int};
+__attribute__((const)) Big cobf(int x) throws;
+
+int caller(int x) throws {
+  // CHECK: call { { ptr, i64 }, i1 } @_Z3cofDri(i32 noundef %{{.*}}) #[[CONST_CALL:[0-9]+]]
+  return try(cof(x));
+}
+// Register return: full memory(none); the discriminant is just another
+// result component.
+// CHECK-LABEL: declare { { ptr, i64 }, i1 } @_Z3cofDri(i32 noundef)
+// CHECK-SAME:  #[[CONST_ATTRS:[0-9]+]]
+
+int caller2(int x) throws {
+  // CHECK: call { { ptr, i64 }, i1 } @_Z3pufDri(i32 noundef %{{.*}}) #[[PURE_CALL:[0-9]+]]
+  return try(puf(x));
+}
+// CHECK-LABEL: declare { { ptr, i64 }, i1 } @_Z3pufDri(i32 noundef)
+// CHECK-SAME:  #[[PURE_ATTRS:[0-9]+]]
+
+int caller3(int x) throws {
+  // CHECK: call { i32, i1 } @_Z4coffDEiEi(i32 noundef %{{.*}}) #[[CONST_CALL]]
+  return try(coff(x));
+}
+// CHECK-LABEL: declare { i32, i1 } @_Z4coffDEiEi(i32 noundef)
+// CHECK-SAME:  #[[CONST_ATTRS]]
+
+Big bcaller(int x) throws {
+  // CHECK: call { { ptr, i64 }, i1 } @_Z4cobfDri(ptr writable herbthrows_sret(%struct.Big) align 8 %{{.*}}, i32 noundef %{{.*}}) #[[SRET_CALL:[0-9]+]]
+  return try(cobf(x));
+}
+// Indirect payload: the payload is written through the 'herbthrows_sret' pointer,
+// so the memory effect is weakened to argmem -- exactly like a plain 'sret'
+// return. The discriminant still rides in the {E, i1} result.
+// CHECK-LABEL: declare { { ptr, i64 }, i1 } @_Z4cobfDri(ptr writable herbthrows_sret(%struct.Big) align 8, i32 noundef)
+// CHECK-SAME:  #[[SRET_ATTRS:[0-9]+]]
+
+// CHECK-DAG: attributes #[[CONST_ATTRS]] = { {{.*}}herbthrows{{.*}}willreturn memory(none){{.*}} }
+// CHECK-DAG: attributes #[[PURE_ATTRS]] = { {{.*}}herbthrows{{.*}}willreturn memory(read){{.*}} }
+// CHECK-DAG: attributes #[[SRET_ATTRS]] = { {{.*}}herbthrows{{.*}}willreturn memory(argmem: readwrite){{.*}} }
+// CHECK-DAG: attributes #[[CONST_CALL]] = { {{.*}}herbthrows{{.*}}memory(none) }
+// CHECK-DAG: attributes #[[PURE_CALL]] = { {{.*}}herbthrows{{.*}}memory(read) }
+// CHECK-DAG: attributes #[[SRET_CALL]] = { {{.*}}herbthrows{{.*}}memory(argmem: readwrite) }
diff --git a/clang/test/CodeGen/herbceptions-coroutine-legacy.cpp b/clang/test/CodeGen/herbceptions-coroutine-legacy.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..1dbec2a0737bf4dfc30400992d324235167202b5
--- /dev/null
+++ b/clang/test/CodeGen/herbceptions-coroutine-legacy.cpp
@@ -0,0 +1,57 @@
+// RUN: %clang -std=c++20 -fherbceptions -fcxx-exceptions -S -emit-llvm -o - %s | FileCheck %s
+
+// A 'throws' coroutine must also catch legacy C++ exceptions escaping its
+// body: the synthesized handler converts them to a __cxx_std_error in the
+// itanium exception_ptr domain and delivers it to
+// promise.unhandled_herbception(__cxx_std_error), the same hook used for
+// herbception errors.
+// Self-contained: defines coroutine machinery manually.
+
+namespace std {
+template <typename T, typename... Args>
+struct coroutine_traits {};
+struct suspend_never {
+  constexpr bool await_ready() const noexcept { return true; }
+  constexpr void await_suspend(auto) const noexcept {}
+  constexpr void await_resume() const noexcept {}
+};
+template <typename Promise = void>
+struct coroutine_handle {
+  constexpr coroutine_handle() noexcept = default;
+  static coroutine_handle from_address(void* addr) { return {}; }
+};
+}
+
+struct HerbTask {
+  struct promise_type {
+    __cxx_std_error error{};
+    HerbTask get_return_object() { return {}; }
+    std::suspend_never initial_suspend() { return {}; }
+    std::suspend_never final_suspend() noexcept { return {}; }
+    void return_void() {}
+    void unhandled_herbception(__cxx_std_error e) noexcept { error = e; }
+    void unhandled_exception() {}
+  };
+};
+
+template <>
+struct std::coroutine_traits<HerbTask, int> {
+  using promise_type = HerbTask::promise_type;
+};
+
+void throws_legacy() { throw int{5}; }
+
+// CHECK-LABEL: define {{.*}} @_Z9herb_taskDri(
+// The body runs inside a try so the legacy throw unwinds to a landingpad...
+// CHECK: invoke void @_Z13throws_legacyv()
+// CHECK: landingpad { ptr, i32 }
+// ...whose handler boxes the exception pointer into a cxx_std_error in the
+// itanium exception_ptr domain...
+// CHECK: call ptr @__cxa_error_domain_itanium_exception_ptr()
+// CHECK: call i64 @__cxa_error_code_itanium_exception_ptr(
+// ...and passes the converted error to the herbceptions hook.
+// CHECK: call void @_ZN8HerbTask12promise_type21unhandled_herbceptionE15__cxx_std_error(
+HerbTask herb_task(int x) throws {
+  throws_legacy();
+  co_return;
+}
diff --git a/clang/test/CodeGen/herbceptions-coroutine.cpp b/clang/test/CodeGen/herbceptions-coroutine.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..8a43b97839f09c69621131a5e0164c1b0790e3ee
--- /dev/null
+++ b/clang/test/CodeGen/herbceptions-coroutine.cpp
@@ -0,0 +1,89 @@
+// RUN: %clang -std=c++20 -fherbceptions -fno-exceptions -S -emit-llvm -o - %s | FileCheck %s
+
+// A non-throws coroutine still compiles with -fherbceptions, and a 'throws'
+// coroutine wraps its body so that an escaping herbception is delivered to
+// promise.unhandled_herbception(__cxx_std_error).
+// Self-contained: defines coroutine machinery manually.
+
+namespace std {
+template <typename T, typename... Args>
+struct coroutine_traits {};
+struct suspend_never {
+  constexpr bool await_ready() const noexcept { return true; }
+  constexpr void await_suspend(auto) const noexcept {}
+  constexpr void await_resume() const noexcept {}
+};
+struct suspend_always {
+  constexpr bool await_ready() const noexcept { return false; }
+  constexpr void await_suspend(auto) const noexcept {}
+  constexpr void await_resume() const noexcept {}
+};
+template <typename Promise = void>
+struct coroutine_handle {
+  constexpr coroutine_handle() noexcept = default;
+  static coroutine_handle from_address(void* addr) { return {}; }
+  constexpr void* address() const noexcept { return nullptr; }
+  constexpr bool done() const noexcept { return true; }
+  constexpr void resume() const {}
+  constexpr void destroy() const {}
+  constexpr operator bool() const noexcept { return true; }
+};
+struct noop_coroutine_promise {};
+using noop_coroutine_handle = coroutine_handle<noop_coroutine_promise>;
+noop_coroutine_handle noop_coroutine() noexcept { return {}; }
+}
+
+struct Task {
+  struct promise_type {
+    Task get_return_object() { return {}; }
+    std::suspend_never initial_suspend() { return {}; }
+    std::suspend_never final_suspend() noexcept { return {}; }
+    void return_void() {}
+    void unhandled_exception() {}
+  };
+};
+
+template <>
+struct std::coroutine_traits<Task, int> {
+  using promise_type = Task::promise_type;
+};
+
+// CHECK: define{{.*}} @_Z9make_taski
+// CHECK: coroutine
+Task make_task(int x) {
+  co_return;
+}
+
+// 'throws' coroutine: the body is wrapped in a catch-throws handler so an
+// escaping error reaches promise.unhandled_herbception, and the return
+// union/discriminant stay on the ramp's stack (coro.outside.frame).
+struct HerbTask {
+  struct promise_type {
+    __cxx_std_error error{};
+    HerbTask get_return_object() { return {}; }
+    std::suspend_never initial_suspend() { return {}; }
+    std::suspend_never final_suspend() noexcept { return {}; }
+    void return_void() {}
+    void unhandled_herbception(__cxx_std_error e) noexcept { error = e; }
+    void unhandled_exception() {}
+  };
+};
+
+template <>
+struct std::coroutine_traits<HerbTask, int> {
+  using promise_type = HerbTask::promise_type;
+};
+
+extern void some_throws() throws;
+
+// CHECK: define {{.*}} @_Z9herb_taskDri
+// CHECK: coro.outside.frame
+// CHECK: unhandled_herbception
+HerbTask herb_task(int x) throws {
+  some_throws();
+  co_return;
+}
+
+int main() {
+  return 0;
+}
diff --git a/clang/test/CodeGen/herbceptions-ctor-catch.cpp b/clang/test/CodeGen/herbceptions-ctor-catch.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3ddaa4dc0da1b4ae6f46952485030a0c10b03ea5
--- /dev/null
+++ b/clang/test/CodeGen/herbceptions-ctor-catch.cpp
@@ -0,0 +1,56 @@
+// RUN: %clang -std=c++26 -fherbceptions -fno-exceptions -S -fdiscard-value-names -emit-llvm -o - %s | FileCheck %s
+
+// A constructor that throws a herbception inside a `try { } catch throws(...)`
+// block must route the error to the catch handler. Previously the switch in
+// the continuation block had two cases for i32 0 instead of i32 0 and i32 1,
+// which made the catch handler unreachable when the first constructor throws.
+
+namespace std {
+struct error {
+  void *domain;
+  __SIZE_TYPE__ code;
+  ~error() noexcept;
+};
+enum class errc : unsigned { io_error = 5 };
+template <typename T> class error_domain;
+template <> class error_domain<errc> {
+public:
+  static void *domain() noexcept;
+  static __SIZE_TYPE__ code(errc) noexcept;
+};
+} // namespace std
+
+// Struct that throws on construction
+struct bad_file {
+  int fd;
+  bad_file() throws {
+    throw throws ::std::errc::io_error;
+  }
+  ~bad_file() noexcept {}
+};
+
+// Struct that succeeds on construction
+struct good_file {
+  int fd;
+  good_file() throws : fd(1) {}
+  ~good_file() noexcept {}
+};
+
+// When the first constructor throws, the catch handler must be reachable.
+// CHECK: define dso_local noundef i32 @_Z8test_bugv()
+// CHECK: call { { ptr, i64 }, i1 } @_ZN8bad_fileC2EDrv
+// CHECK: extractvalue { { ptr, i64 }, i1 } %{{.*}}, 1
+// CHECK: br i1 %{{.*}}, label %{{[0-9]+}}, label %{{[0-9]+}}
+// CHECK: store %"struct.std::error" %{{.*}}, ptr %
+// CHECK: switch i32 %{{.*}}, label %{{[0-9]+}} [
+// CHECK: i32 {{[0-9]+}}, label %{{[0-9]+}}
+// CHECK: i32 {{[0-9]+}}, label %{{[0-9]+}}
+// CHECK-NEXT: ]
+
+int test_bug() try {
+  bad_file f1;      // Throws
+  good_file f2;     // Should not reach
+  return 0;
+} catch throws(std::error e) {
+  return 1;
+}
diff --git a/clang/test/CodeGen/herbceptions-ctor-throws.cpp b/clang/test/CodeGen/herbceptions-ctor-throws.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..90b3828d4648dab8edab544ba7743b7741c3994a
--- /dev/null
+++ b/clang/test/CodeGen/herbceptions-ctor-throws.cpp
@@ -0,0 +1,37 @@
+// RUN: %clang -std=c++20 -fherbceptions -fno-exceptions -S -emit-llvm -o - %s | FileCheck %s
+
+// Regression test: a `throws` constructor whose member-initializer calls a
+// `throws` function used to crash CodeGen. Its CGFunctionInfo was not given
+// the herbception throws ABI (HasThrowsReturn / error type), so StartFunction
+// left the return value slot invalid and EmitHerbceptionTry called
+// DataLayout::getTypeAllocSize on a null Type*. The constructor must be
+// lowered with the {E, i1} ABI like any other throws function, giving its body
+// a valid payload slot to store the propagated error.
+
+namespace std {
+struct error { void *d; __SIZE_TYPE__ c; };
+}
+
+int open_resource() throws;
+
+struct A {
+  int fd;
+  A() throws : fd(open_resource()) {}
+};
+
+// A `throws` constructor invoked from a `throws` function propagates the
+// error. The call site must agree with the constructor's {E, i1} definition
+// ABI, and (since Sema does not wrap constructor calls in `try(expr)`) the
+// auto-propagate path stores the payload and sets the discriminant.
+// CHECK-LABEL: define dso_local { { ptr, i64 }, i1 } @_Z4makeDrv(
+// CHECK:         call { { ptr, i64 }, i1 } @_ZN1AC2EDrv(
+int make() throws {
+  A a{};
+  return a.fd;
+}
+
+// The constructor itself carries the {E, i1} return ABI (E = std::error, the
+// implicit 2-register {void*, size_t} struct), so its member-initializer call
+// to a throws function can store the error payload and set the discriminant
+// on failure instead of crashing.
+// CHECK: define {{.*}}dso_local { { ptr, i64 }, i1 } @_ZN1AC{{[12]}}EDrv(
