+; RUN: llvm-as < %s | llvm-dis | FileCheck %s
+; RUN: verify-uselistorder < %s
+
+; herbthrows_sret must survive an assembly -> bitcode -> assembly round trip,
+; including its carried pointee type, on declarations, definitions and calls.
+
+; CHECK: define { ptr, i64 } @ret_payload(ptr herbthrows_sret({ i64, i64, i64, i64 }) %out, i32 %n)
+define { ptr, i64 } @ret_payload(ptr herbthrows_sret({ i64, i64, i64, i64 }) %out, i32 %n) {
+entry:
+  store i64 1, ptr %out, align 8
+  ret { ptr, i64 } zeroinitializer
+}
+
+; CHECK: declare { ptr, i64 } @decl(ptr herbthrows_sret({ i64, i64, i64, i64 }))
+declare { ptr, i64 } @decl(ptr herbthrows_sret({ i64, i64, i64, i64 }))
+
+; CHECK: call { ptr, i64 } @decl(ptr herbthrows_sret({ i64, i64, i64, i64 }) %
+define { ptr, i64 } @caller(ptr herbthrows_sret({ i64, i64, i64, i64 }) %out) {
+  %r = call { ptr, i64 } @decl(ptr herbthrows_sret({ i64, i64, i64, i64 }) %out)
+  ret { ptr, i64 } %r
+}
diff --git a/llvm/test/CodeGen/WebAssembly/throws-attr.ll b/llvm/test/CodeGen/WebAssembly/throws-attr.ll
new file mode 100644
index 0000000000000000000000000000000000000000..192615698323a000de8926657a5fa3c310dd64c7
--- /dev/null
+++ b/llvm/test/CodeGen/WebAssembly/throws-attr.ll
@@ -0,0 +1,60 @@
+; RUN: llc -mtriple=wasm32-unknown-unknown -mattr=+multivalue < %s | FileCheck %s
+; RUN: llc -mtriple=wasm64-unknown-unknown -mattr=+multivalue < %s | FileCheck %s
+; RUN: llc -mtriple=wasm32-unknown-unknown -mattr=-multivalue < %s | FileCheck %s --check-prefix=MVP
+; RUN: llc -mtriple=wasm64-unknown-unknown -mattr=-multivalue < %s | FileCheck %s --check-prefix=NO-MULTI64
+; MVP: .functype ret_success (i32, i64) -> ()
+; MVP: .functype ret_error (i32, i64) -> ()
+; NO-MULTI64: .functype ret_success (i64, i64) -> ()
+; NO-MULTI64: .functype ret_error (i64, i64) -> ()
+
+; A function with the throws (herbception) attribute returns its value with a
+; discriminant. On WebAssembly the discriminant is returned as an extra
+; multivalue result.
+
+; Success: value in result 0, discriminant (0) in result 1.
+define { i64, i1 } @ret_success(i64 %x) #0 {
+; CHECK-LABEL: ret_success:
+; CHECK:         .functype ret_success (i64) -> (i64, i32)
+; CHECK:         local.get 0
+; CHECK-NEXT:    i32.const 0
+entry:
+  %r.i = insertvalue { i64, i1 } poison, i64 %x, 0
+  %r = insertvalue { i64, i1 } %r.i, i1 false, 1
+  ret { i64, i1 } %r
+}
+
+; Error: discriminant is true (1) in result 1.
+define { i64, i1 } @ret_error(i64 %x) #0 {
+; CHECK-LABEL: ret_error:
+; CHECK:         .functype ret_error (i64) -> (i64, i32)
+; CHECK:         local.get 0
+; CHECK-NEXT:    i32.const 1
+entry:
+  %r.i = insertvalue { i64, i1 } poison, i64 %x, 0
+  %r = insertvalue { i64, i1 } %r.i, i1 true, 1
+  ret { i64, i1 } %r
+}
+
+; The caller selects on the extra discriminant value.
+define i64 @call_and_select(i64 %x) #1 {
+; CHECK-LABEL: call_and_select:
+; CHECK:         .functype call_and_select (i64) -> (i64)
+; CHECK:         call ret_error
+; CHECK-NEXT:    local.set 1
+; CHECK-NEXT:    local.set 0
+; CHECK-NEXT:    i64.const 100
+; CHECK-NEXT:    local.get 0
+; CHECK-NEXT:    local.get 1
+; CHECK-NEXT:    i32.const 1
+; CHECK-NEXT:    i32.and
+; CHECK-NEXT:    i64.select
+entry:
+  %c = call { i64, i1 } @ret_error(i64 %x)
+  %val = extractvalue { i64, i1 } %c, 0
+  %disc = extractvalue { i64, i1 } %c, 1
+  %sel = select i1 %disc, i64 100, i64 %val
+  ret i64 %sel
+}
+
+attributes #0 = { herbthrows }
+attributes #1 = { nounwind }
diff --git a/llvm/test/CodeGen/WebAssembly/throws-indirect.ll b/llvm/test/CodeGen/WebAssembly/throws-indirect.ll
new file mode 100644
index 0000000000000000000000000000000000000000..5f3812e86a75c57493d771ba9f4d2e2039bb3a19
--- /dev/null
+++ b/llvm/test/CodeGen/WebAssembly/throws-indirect.ll
@@ -0,0 +1,19 @@
+; RUN: llc -mtriple=wasm32 -mattr=+multivalue < %s | FileCheck %s
+; RUN: llc -mtriple=wasm32 -mattr=+multivalue -global-isel -global-isel-abort=0 < %s | FileCheck %s
+; RUN: llc -mtriple=wasm64 -mattr=+multivalue < %s | FileCheck %s
+
+; A plain caller and an indirect call use the callee's Herb ABI. The global
+; materializes an independently callable target with the same function type.
+@slot = global ptr @target
+declare { i64, i1 } @target(i64) herbthrows
+; CHECK: .functype target (i64) -> (i64, i32)
+define i64 @plain_caller(i64 %x) {
+; CHECK-LABEL: plain_caller:
+; CHECK: call_indirect
+  %callee = load volatile ptr, ptr @slot
+  %result = call { i64, i1 } %callee(i64 %x) herbthrows
+  %value = extractvalue { i64, i1 } %result, 0
+  %failed = extractvalue { i64, i1 } %result, 1
+  %ret = select i1 %failed, i64 -1, i64 %value
+  ret i64 %ret
+}
