diff --git a/libherbceptions/test/no_exceptions_api_test.cpp b/libherbceptions/test/no_exceptions_api_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..23faddce715e8fc7b34b32b9b2f1009a89a83ccb
--- /dev/null
+++ b/libherbceptions/test/no_exceptions_api_test.cpp
@@ -0,0 +1,47 @@
+//===--- no_exceptions_api_test.cpp - -fno-exceptions API surface ---------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// The exception_ptr domain ABI entry points and the header-only cast/unbox
+// helpers are implemented inside the runtime (always built with EH), so
+// consumers compiling with -fno-exceptions must still see their
+// declarations. Only APIs that literally throw in the consumer TU
+// (throw_legacy_exception*) degrade under -fno-exceptions.
+//
+// RUN: %cxx -fherbceptions -fno-exceptions -std=c++2c -fsyntax-only \
+// RUN:   -I%herbceptions_include %s
+// RUN: %cxx -fherbceptions -fno-exceptions -fno-rtti -std=c++2c \
+// RUN:   -fsyntax-only -I%herbceptions_include %s
+//
+//===----------------------------------------------------------------------===//
+
+#include <exception>
+#include <herbceptions/error>
+#include <typeinfo>
+
+struct api_base {
+  virtual ~api_base() = default;
+};
+
+int probe(::std::error const &e) {
+#if defined(_LIBHERBCEPTIONS_CPP_RTTI)
+#ifdef _MSC_VER
+  void *p = ::std::error_domains::__cxa_error_code_msvc_exception_ptr_cast(
+      e.domain(), e.code(), __builtin_addressof(typeid(api_base)));
+#else
+  void *p = ::std::error_domains::__cxa_error_code_itanium_exception_ptr_cast(
+      e.domain(), e.code(), __builtin_addressof(typeid(api_base)));
+#endif
+  (void)p;
+#endif
+  // Available in every configuration; yields nullptr under -fno-rtti.
+  api_base *b = ::std::exception_cast_std_error<api_base *>(e);
+  (void)b;
+  ::std::exception_ptr ep = ::std::make_exception_ptr_from_std_error(e);
+  (void)ep;
+  return 0;
+}
diff --git a/libherbceptions/test/release_test.cpp b/libherbceptions/test/release_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..14150c29ed52fac789a39e7dbd4c59f9b825f322
--- /dev/null
+++ b/libherbceptions/test/release_test.cpp
@@ -0,0 +1,85 @@
+//===--- release_test.cpp - std::error::release() tests
+//--------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Tests std::error::release(): it moves the {domain, code} payload out as a
+// cxx_std_error, rebinds the source error to {posix domain, 0}, and the
+// released value can re-enter the channel via throw throws.
+//
+// RUN: %cxx %herbceptions_flags -I%herbceptions_include -L%herbceptions_lib
+// -lherbceptions %s -o %t && %t | %FileCheck %s CHECK: PASS
+//
+//===----------------------------------------------------------------------===//
+
+#include "herbceptions/error"
+
+#include <cstdio>
+#include <cstring>
+
+static int failures = 0;
+#define CHECK(cond)                                                            \
+  do {                                                                         \
+    if (!(cond)) {                                                             \
+      std::printf("FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond);              \
+      ++failures;                                                              \
+    }                                                                          \
+  } while (0)
+
+static void thrower() throws { throw throws::std::errc::permission_denied; }
+
+static void rethrower(::std::cxx_std_error e) throws {
+  CHECK(e.domain != nullptr); // never rethrow a null-domain value
+  throw throws e;
+}
+
+int main() {
+  auto const *posix = ::std::error_domains::__cxa_error_domain_posix();
+
+  ::std::cxx_std_error rel{};
+  CHECK(rel.domain == nullptr); // zero-init means "no error"
+
+  // First hop: catch the error, inspect, release.
+  try {
+    thrower();
+    CHECK(false && "unreached");
+  } catch throws(::std::error e) {
+    CHECK(e.domain() == posix);
+    CHECK(e.code() == 13);
+
+    rel = e.release();
+    // Released payload carries the original domain + code.
+    CHECK(rel.domain == posix);
+    CHECK(rel.code == 13);
+    // The rebound error is {posix, 0} — the success value; its destructor
+    // has nothing to clean up.
+    CHECK(e.domain() == posix);
+    CHECK(e.code() == 0);
+    CHECK(e == ::std::errc{});
+  }
+
+  // Second hop: put the released pair back on the channel.
+  try {
+    rethrower(rel);
+    CHECK(false && "unreached");
+  } catch throws(::std::error e) {
+    CHECK(e.domain() == posix);
+    CHECK(e.code() == 13);
+    CHECK(e == ::std::errc::permission_denied);
+  }
+  // rel was consumed by the rethrow; the caller's copy is unchanged bits —
+  // ownership-wise it is spent, nothing destroys it.
+
+  // release() inside a constexpr-friendly path — see the Sema test for the
+  // constant-evaluated version; here just verify the type is the builtin.
+  static_assert(__is_same(::std::cxx_std_error, __CXX_STD_ERROR_TYPE__));
+  static_assert(sizeof(::std::cxx_std_error) == 2 * sizeof(void *));
+
+  if (failures == 0)
+    std::printf("PASS\n");
+  return failures;
+}
diff --git a/libherbceptions/test/tls_alert_test.cpp b/libherbceptions/test/tls_alert_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d17be5035bc6aaf9833675bd9706aebf7cffe47a
--- /dev/null
+++ b/libherbceptions/test/tls_alert_test.cpp
@@ -0,0 +1,167 @@
+//===--- tls_alert_test.cpp - std::tls_alert domain tests -----------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Tests the tls alert error domain: domain identity, code() == the packed
+// (alert_level, alert_description) wire pair, do_to_errc mapping,
+// do_query_information text, unlisted codes/levels, and a throws/catch
+// round trip preserving both wire bytes.
+//
+// RUN: %cxx %herbceptions_flags -I%herbceptions_include -L%herbceptions_lib
+// -lherbceptions %s -o %t && %t | %FileCheck %s CHECK: PASS
+//
+//===----------------------------------------------------------------------===//
+
+#include "herbceptions/error"
+
+#include <cstdio>
+#include <cstring>
+#include <string>
+
+static int failures = 0;
+#define CHECK(cond)                                                            \
+  do {                                                                         \
+    if (!(cond)) {                                                             \
+      std::printf("FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond);              \
+      ++failures;                                                              \
+    }                                                                          \
+  } while (0)
+
+namespace {
+struct capture_ctx {
+  char buf[512];
+  std::size_t len;
+};
+} // namespace
+
+static void capture_cookfun(void *cookie, ::std::io_scatter_t const *v,
+                            ::std::size_t n) noexcept {
+  auto *ctx = static_cast<capture_ctx *>(cookie);
+  for (std::size_t i = 0; i < n; ++i) {
+    for (std::size_t j = 0; j < v[i].len; ++j) {
+      if (ctx->len < sizeof(ctx->buf) - 1)
+        ctx->buf[ctx->len++] = static_cast<char const *>(v[i].base)[j];
+    }
+  }
+  ctx->buf[ctx->len] = '\0';
+}
+
+static void thrower() throws {
+  throw throws::std::tls_alert{::std::tls_alert::alert_level::fatal,
+                               ::std::tls_alert::alert_description::unknown_ca};
+}
+
+int main() {
+  using alert = ::std::tls_alert;
+  using level = ::std::tls_alert::alert_level;
+  using desc = ::std::tls_alert::alert_description;
+
+  auto const *tls = ::std::error_domains::__cxa_error_domain_tls();
+  CHECK(tls != nullptr);
+  CHECK(::std::error_domain<alert>::domain() == tls);
+
+  // code() packs the two wire bytes: (level << 8) | description.
+  CHECK(::std::error_domain<alert>::code(
+            alert{level::fatal, desc::unknown_ca}) == 560);
+  CHECK(::std::error_domain<alert>::code(
+            alert{level::warning, desc::close_notify}) == 256);
+  CHECK(::std::error_domain<alert>::code(
+            alert{level::fatal, desc::decode_error}) == 562);
+
+  // do_to_errc: closures are not errors, cert/auth alerts are
+  // permission_denied, negotiation alerts are protocol_not_supported,
+  // and everything else is a peer-protocol failure.
+  CHECK(tls->do_to_errc(256) == ::std::errc{}); // warning close_notify
+  CHECK(tls->do_to_errc(0) == ::std::errc{});   // fatal close_notify
+  CHECK(tls->do_to_errc((2u << 8) | 42u) == ::std::errc::permission_denied);
+  CHECK(tls->do_to_errc((2u << 8) | 45u) == ::std::errc::permission_denied);
+  CHECK(tls->do_to_errc((2u << 8) | 48u) == ::std::errc::permission_denied);
+  CHECK(tls->do_to_errc((2u << 8) | 116u) == ::std::errc::permission_denied);
+  CHECK(tls->do_to_errc((2u << 8) | 22u) == ::std::errc::message_size);
+  CHECK(tls->do_to_errc((2u << 8) | 70u) ==
+        ::std::errc::protocol_not_supported);
+  CHECK(tls->do_to_errc((2u << 8) | 120u) ==
+        ::std::errc::protocol_not_supported);
+  CHECK(tls->do_to_errc((2u << 8) | 80u) == ::std::errc::io_error);
+  CHECK(tls->do_to_errc((2u << 8) | 117u) == ::std::errc::io_error);
+  CHECK(tls->do_to_errc((2u << 8) | 50u) == ::std::errc::protocol_error);
+  CHECK(tls->do_to_errc((2u << 8) | 200u) ==
+        ::std::errc::protocol_error); // unassigned description
+
+  // do_query_information: "[domain](level:desc)Literal: Message".
+  capture_ctx nctx{};
+  tls->do_query_information(560, ::std::error_query_information::name,
+                            ::std::error_reporter_encoding::utf8, &nctx,
+                            capture_cookfun);
+  CHECK(std::string(nctx.buf, nctx.len) == "tls");
+
+  capture_ctx mctx{};
+  tls->do_query_information(560, ::std::error_query_information::message,
+                            ::std::error_reporter_encoding::utf8, &mctx,
+                            capture_cookfun);
+  CHECK(std::string(mctx.buf, mctx.len) == "(2:48)Fatal: Unknown CA");
+
+  capture_ctx nmctx{};
+  tls->do_query_information(560, ::std::error_query_information::name_message,
+                            ::std::error_reporter_encoding::utf8, &nmctx,
+                            capture_cookfun);
+  CHECK(std::string(nmctx.buf, nmctx.len) == "[tls](2:48)Fatal: Unknown CA");
+
+  // Warning level prints its literal.
+  capture_ctx wctx{};
+  tls->do_query_information(256, ::std::error_query_information::message,
+                            ::std::error_reporter_encoding::utf8, &wctx,
+                            capture_cookfun);
+  CHECK(std::string(wctx.buf, wctx.len) == "(1:0)Warning: Close Notify");
+
+  // Unlisted description + unknown level byte still render.
+  capture_ctx uctx{};
+  tls->do_query_information(
+      (7u << 8) | 200u, ::std::error_query_information::name_message,
+      ::std::error_reporter_encoding::utf8, &uctx, capture_cookfun);
+  CHECK(std::string(uctx.buf, uctx.len) == "[tls](7:200)Unknown: Unknown");
+
+  // Same-domain equivalence requires BOTH wire bytes to match: a warning
+  // close_notify and a fatal one are different codes.
+  CHECK(tls->do_equivalent(560, tls, 560));
+  CHECK(!tls->do_equivalent(560, tls, 561));
+  CHECK(!tls->do_equivalent(256, tls, 0));
+
+  // throws/catch round trip preserves level and description.
+  try {
+    thrower();
+    CHECK(false && "unreached");
+  } catch throws(::std::error e) {
+    CHECK(e.domain() == tls);
+    CHECK(e.code() == 560);
+    CHECK((e == alert{level::fatal, desc::unknown_ca}));
+    CHECK((e != alert{level::warning, desc::unknown_ca}));
+    CHECK(e.to_errc() == ::std::errc::permission_denied);
+    auto const a{::std::herbception_cast<alert>(e)};
+    CHECK(a.level == level::fatal);
+    CHECK(a.description == desc::unknown_ca);
+  }
+
+  // A peer-sent warning-level alert keeps its level byte on the wire.
+  try {
+    try {
+      throw throws(alert{level::warning, desc::user_canceled});
+    } catch throws(::std::error e) {
+      CHECK(e.code() == ((1u << 8) | 90u));
+      CHECK(e.to_errc() == ::std::errc{});
+      throw throws e; // rethrow
+    }
+    CHECK(false && "unreached");
+  } catch throws(::std::error e) {
+    CHECK(e.domain() == tls);
+    CHECK(e.code() == 346);
+  }
+
+  if (failures == 0)
+    std::printf("PASS\n");
+  return failures;
+}
