diff --git a/libherbceptions/CMakeLists.txt b/libherbceptions/CMakeLists.txt
new file mode 100644
index 0000000000000000000000000000000000000000..16fec7d4162feea22e96d07a8e0b25d60ba8615e
--- /dev/null
+++ b/libherbceptions/CMakeLists.txt
@@ -0,0 +1,368 @@
+#===--- CMakeLists.txt - Herbception error-domain runtime -------------===#
+#
+# Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+# See https://llvm.org/LICENSE.txt for license information.
+# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#
+#===----------------------------------------------------------------------===#
+#
+# libherbceptions — the error-domain runtime used by the 'throws'/'return_failure{E}'
+# herbception exception model. Also a first-class LLVM runtime: add
+# "libherbceptions" to LLVM_ENABLE_RUNTIMES.
+#
+#==========================================================================#
+
+cmake_minimum_required(VERSION 3.20)
+
+if(CMAKE_SOURCE_DIR STREQUAL CMAKE_CURRENT_SOURCE_DIR)
+  project(libherbceptions CXX)
+endif()
+
+set(LIBHERBCEPTIONS_VERSION 1.0.0)
+string(REGEX REPLACE "^([0-9]+)\\..*" "\\1" LIBHERBCEPTIONS_VERSION_MAJOR
+  ${LIBHERBCEPTIONS_VERSION})
+
+option(LIBHERBCEPTIONS_BUILD_SHARED "Build the shared library" ON)
+option(LIBHERBCEPTIONS_BUILD_STATIC "Build the static library" ON)
+option(LIBHERBCEPTIONS_HEADERS_ONLY "Header-only build" OFF)
+option(LIBHERBCEPTIONS_FREESTANDING "Build with -ffreestanding" OFF)
+option(LIBHERBCEPTIONS_ENABLE_EXCEPTIONS "Enable C++ dynamic exception handling (not herbceptions)" ON)
+option(LIBHERBCEPTIONS_ENABLE_RTTI "Enable C++ RTTI" ON)
+option(LIBHERBCEPTIONS_ENABLE_EBCDIC "Build with EBCDIC support for guard against -fexec-charset= EBCDIC charsets" OFF)
+option(LIBHERBCEPTIONS_NO_MESSAGES "Strip domain message text; errors report only \"[domain](numeric code)\"" ${LIBHERBCEPTIONS_FREESTANDING})
+option(LIBHERBCEPTIONS_NO_LIB_PREFIX "Emit the shared library without the 'lib' prefix (herbceptions.so/herbceptions.dll)" OFF)
+option(LIBHERBCEPTIONS_ENABLE_ITANIUM_EXCEPTION_PTR_DOMAIN "Build the Itanium exception_ptr error domain into libherbceptions instead of relying on the C++ runtime (libsupc++/libc++abi)" OFF)
+option(LIBHERBCEPTIONS_BUILD_BOTH_SHARED_NAMES "Emit both prefixed and unprefixed names for the shared library (libherbceptions.so and herbceptions.so / libherbceptions.dll and herbceptions.dll)" OFF)
+option(LIBHERBCEPTIONS_BUILD_TESTS "Build the tests" OFF)
+option(LIBHERBCEPTIONS_BUILD_FUZZERS "Build the fuzz targets" OFF)
+option(LIBHERBCEPTIONS_FUZZ_ENGINE "Link fuzz targets against libFuzzer" OFF)
+
+# Windows built with the MSVC frontend (clang-cl or MSVC) does not accept
+# GCC-style flags; the GNU frontend (MinGW) does.
+if(CMAKE_SYSTEM_NAME STREQUAL "Windows" AND
+   CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
+  set(LIBHERBCEPTIONS_MSVC_ABI ON)
+else()
+  set(LIBHERBCEPTIONS_MSVC_ABI OFF)
+endif()
+
+set(LIBHERBCEPTIONS_SOURCES
+  src/posix.cpp
+  src/parse.cpp
+  src/cmath_errc.cpp
+  src/http_errc.cpp
+  src/tls_alert.cpp
+  src/query_information.cpp
+  src/msvc_exception_ptr.cpp
+  src/win32.cpp
+  src/nt.cpp
+  src/com.cpp
+  src/wine.cpp
+)
+
+add_library(herbceptions_headers INTERFACE)
+target_include_directories(herbceptions_headers INTERFACE
+  $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
+  $<INSTALL_INTERFACE:include>
+)
+
+if(LIBHERBCEPTIONS_FREESTANDING)
+  target_compile_options(herbceptions_headers INTERFACE -ffreestanding)
+endif()
+if(NOT LIBHERBCEPTIONS_ENABLE_EXCEPTIONS)
+  if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
+    target_compile_options(herbceptions_headers INTERFACE -fno-exceptions)
+  endif()
+  if(CMAKE_SYSTEM_NAME STREQUAL "Windows" AND CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
+    target_compile_definitions(herbceptions_headers INTERFACE _HAS_EXCEPTIONS=0)
+  endif()
+endif()
+if(NOT LIBHERBCEPTIONS_ENABLE_RTTI)
+  if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
+    target_compile_options(herbceptions_headers INTERFACE -fno-rtti)
+  endif()
+  if(CMAKE_SYSTEM_NAME STREQUAL "Windows" AND CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
+    target_compile_definitions(herbceptions_headers INTERFACE _HAS_RTTI=0)
+  endif()
+endif()
+if(LIBHERBCEPTIONS_ENABLE_EBCDIC)
+  if(CMAKE_SYSTEM_NAME STREQUAL "Windows" AND CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
+    target_compile_definitions(herbceptions_headers INTERFACE __LIBHERBCEPTIONS_ENABLE_EBCDIC=1)
+  endif()
+endif()
+
+# Headers-only build: no runtime sources.
+if(LIBHERBCEPTIONS_HEADERS_ONLY)
+  add_library(herbceptions ALIAS herbceptions_headers)
+  add_library(herbceptions_static ALIAS herbceptions_headers)
+  return()
+endif()
+
+# The Itanium exception_ptr error domain normally lives in the C++ runtime
+# (libsupc++ / libc++abi), so a single herbceptions.dll can serve both the
+# GNU and MSVC ABIs. The in-tree implementation remains available for
+# standalone or freestanding builds.
+if(LIBHERBCEPTIONS_ENABLE_ITANIUM_EXCEPTION_PTR_DOMAIN)
+  add_library(herbceptions_itanium_exception_ptr OBJECT
+    src/itanium_exception_ptr.cpp
+  )
+  target_link_libraries(herbceptions_itanium_exception_ptr PRIVATE herbceptions_headers)
+  target_include_directories(herbceptions_itanium_exception_ptr PRIVATE
+    ${CMAKE_CURRENT_SOURCE_DIR}/src)
+  target_compile_definitions(herbceptions_itanium_exception_ptr PRIVATE
+    _HERBCEPTIONS_BUILDING_RUNTIME=1)
+  if(LIBHERBCEPTIONS_NO_MESSAGES)
+    target_compile_definitions(herbceptions_itanium_exception_ptr PRIVATE
+      __HERBCEPTIONS_NO_MESSAGES=1)
+  endif()
+  if(NOT LIBHERBCEPTIONS_MSVC_ABI)
+    target_compile_options(herbceptions_itanium_exception_ptr PRIVATE
+      -fexceptions -frtti)
+  endif()
+  set_target_properties(herbceptions_itanium_exception_ptr PROPERTIES
+    CXX_STANDARD 23
+    CXX_STANDARD_REQUIRED ON
+    CXX_EXTENSIONS OFF
+  )
+  set(LIBHERBCEPTIONS_DOMAIN_OBJECTS
+    $<TARGET_OBJECTS:herbceptions_itanium_exception_ptr>)
+else()
+  set(LIBHERBCEPTIONS_DOMAIN_OBJECTS)
+endif()
+
+if(LIBHERBCEPTIONS_BUILD_SHARED AND NOT LIBHERBCEPTIONS_FREESTANDING)
+  add_library(herbceptions SHARED ${LIBHERBCEPTIONS_SOURCES} ${LIBHERBCEPTIONS_DOMAIN_OBJECTS})
+endif()
+add_library(herbceptions_static STATIC ${LIBHERBCEPTIONS_SOURCES} ${LIBHERBCEPTIONS_DOMAIN_OBJECTS})
+if(LIBHERBCEPTIONS_BUILD_SHARED AND NOT LIBHERBCEPTIONS_FREESTANDING)
+  set(HERBCEPTIONS_TARGETS herbceptions herbceptions_static)
+else()
+  set(HERBCEPTIONS_TARGETS herbceptions_static)
+endif()
+foreach(target IN LISTS HERBCEPTIONS_TARGETS)
+  target_link_libraries(${target} PUBLIC herbceptions_headers)
+  target_include_directories(${target} PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/src)
+  target_compile_definitions(${target} PRIVATE _HERBCEPTIONS_BUILDING_RUNTIME=1)
+  if(LIBHERBCEPTIONS_NO_MESSAGES)
+    target_compile_definitions(${target} PRIVATE __HERBCEPTIONS_NO_MESSAGES=1)
+  endif()
+  if(LIBHERBCEPTIONS_FREESTANDING)
+    target_compile_options(${target} PRIVATE -ffreestanding)
+  endif()
+  # These domains never raise or inspect C++ EH/RTTI. Only the Itanium
+  # exception_ptr domain needs exception machinery, and it is built
+  # separately when enabled.
+  if(NOT LIBHERBCEPTIONS_MSVC_ABI)
+    target_compile_options(${target} PRIVATE
+      -fno-exceptions -fno-rtti -fno-unwind-tables
+      -fno-asynchronous-unwind-tables -fno-ident)
+  endif()
+  if(WIN32 AND NOT LIBHERBCEPTIONS_MSVC_ABI)
+    # Rethrowing a Microsoft-ABI legacy exception calls RaiseException; the
+    # frames between the raise and the caller must be unwindable, so this one
+    # translation unit needs unwind tables despite the flags above.
+    set_source_files_properties(src/msvc_exception_ptr.cpp PROPERTIES
+      COMPILE_OPTIONS "-funwind-tables")
+  endif()
+  set_target_properties(${target} PROPERTIES
+    CXX_STANDARD 23
+    CXX_STANDARD_REQUIRED ON
+    CXX_EXTENSIONS OFF
+  )
+endforeach()
+if(LIBHERBCEPTIONS_BUILD_SHARED AND NOT LIBHERBCEPTIONS_FREESTANDING)
+  set_target_properties(herbceptions PROPERTIES
+    VERSION ${LIBHERBCEPTIONS_VERSION}
+    SOVERSION ${LIBHERBCEPTIONS_VERSION_MAJOR}
+  )
+  # On Unix-like toolchains shared libraries carry a "lib" prefix
+  # (libherbceptions.so / libherbceptions.dll); clearing it emits
+  # herbceptions.so / herbceptions.dll instead — the same name the MSVC
+  # build produces on Windows, and a valid spelling elsewhere. Windows
+  # always uses the unprefixed name so the GNU and MSVC ABI builds share
+  # one herbceptions.dll.
+  if(LIBHERBCEPTIONS_NO_LIB_PREFIX OR WIN32)
+    set_target_properties(herbceptions PROPERTIES
+      PREFIX ""
+      IMPORT_PREFIX ""
+    )
+  endif()
+  # Emit the alternate name alongside the primary output: whichever
+  # prefix convention the build produces natively, add the other as a
+  # copy. Names derive from the platform suffixes, so this works for
+  # .so / .dylib / .dll alike.
+  if(LIBHERBCEPTIONS_BUILD_BOTH_SHARED_NAMES)
+    if(LIBHERBCEPTIONS_NO_LIB_PREFIX)
+      set(__herbceptions_altname libherbceptions)
+    else()
+      set(__herbceptions_altname herbceptions)
+    endif()
+    add_custom_command(TARGET herbceptions POST_BUILD
+      COMMAND ${CMAKE_COMMAND} -E copy_if_different
+              $<TARGET_FILE:herbceptions>
+              $<TARGET_FILE_DIR:herbceptions>/${__herbceptions_altname}${CMAKE_SHARED_LIBRARY_SUFFIX}
+    )
+    # DLL platforms have a separate import library; ELF/Mach-O do not.
+    if(CMAKE_IMPORT_LIBRARY_SUFFIX)
+      add_custom_command(TARGET herbceptions POST_BUILD
+        COMMAND ${CMAKE_COMMAND} -E copy_if_different
+                $<TARGET_LINKER_FILE:herbceptions>
+                $<TARGET_LINKER_FILE_DIR:herbceptions>/${__herbceptions_altname}${CMAKE_IMPORT_LIBRARY_SUFFIX}
+      )
+    endif()
+    unset(__herbceptions_altname)
+  endif()
+endif()
+
+if(TARGET cxx_shared OR TARGET cxx_static OR LLVM_RUNTIMES_BUILD)
+  set(LIBHERBCEPTIONS_IN_RUNTIMES ON)
+  message(STATUS "libherbceptions runtime hook: LIST_DIR=${CMAKE_CURRENT_LIST_DIR} BIN=${CMAKE_BINARY_DIR}")
+  foreach(d "${CMAKE_CURRENT_SOURCE_DIR}/../libcxxabi/include"
+            "${CMAKE_BINARY_DIR}/include/c++/v1")
+    cmake_path(NORMAL_PATH d)
+    if(EXISTS "${d}")
+      message(STATUS "libherbceptions inc: ${d}")
+    else()
+      message(STATUS "libherbceptions missing: ${d}")
+    endif()
+    if(EXISTS "${d}" AND NOT "${d}" IN_LIST LIBHERBCEPTIONS_LIBCXX_INCLUDES)
+      list(APPEND LIBHERBCEPTIONS_LIBCXX_INCLUDES "${d}")
+    endif()
+  endforeach()
+  foreach(target herbceptions herbceptions_static)
+    if(LIBHERBCEPTIONS_LIBCXX_INCLUDES)
+      target_compile_options(${target} PRIVATE -nostdinc++)
+      foreach(d IN LISTS LIBHERBCEPTIONS_LIBCXX_INCLUDES)
+        target_compile_options(${target} PRIVATE "-isystem${d}")
+      endforeach()
+    endif()
+    if(TARGET cxx_shared)
+      target_link_libraries(${target} PRIVATE cxx_shared)
+      add_dependencies(${target} cxx_shared)
+    elseif(TARGET cxx_static)
+      target_link_libraries(${target} PRIVATE cxx_static)
+      add_dependencies(${target} cxx_static)
+    endif()
+  endforeach()
+endif()
+if(CMAKE_SYSTEM_NAME STREQUAL "Windows" AND LIBHERBCEPTIONS_BUILD_SHARED)
+  set_target_properties(herbceptions_static PROPERTIES
+    OUTPUT_NAME herbceptions_static)
+else()
+  set_target_properties(herbceptions_static PROPERTIES
+    OUTPUT_NAME herbceptions)
+endif()
+if(CMAKE_SYSTEM_NAME STREQUAL "Windows")
+  if(LIBHERBCEPTIONS_BUILD_SHARED AND NOT LIBHERBCEPTIONS_FREESTANDING)
+    target_link_libraries(herbceptions PRIVATE ntdll)
+  endif()
+  target_link_libraries(herbceptions_static PRIVATE ntdll)
+endif()
+
+install(DIRECTORY include/
+  DESTINATION include
+  FILES_MATCHING PATTERN "*.h"
+  PATTERN "error"
+)
+if(LIBHERBCEPTIONS_BUILD_SHARED AND NOT LIBHERBCEPTIONS_FREESTANDING)
+  install(TARGETS herbceptions herbceptions_static
+    LIBRARY DESTINATION lib
+    ARCHIVE DESTINATION lib
+    RUNTIME DESTINATION bin
+  )
+else()
+  install(TARGETS herbceptions_static
+    ARCHIVE DESTINATION lib
+  )
+endif()
+
+if(LIBHERBCEPTIONS_BUILD_TESTS AND NOT LIBHERBCEPTIONS_HEADERS_ONLY)
+  # Lit-based test infrastructure.
+  if(NOT TARGET llvm-lit)
+    find_program(LLVM_LIT_EXECUTABLE llvm-lit
+      HINTS ${LLVM_TOOLS_DIR} $ENV{LLVM_TOOLS_DIR}
+      DOC "Path to llvm-lit")
+    if(LLVM_LIT_EXECUTABLE)
+      message(STATUS "Found llvm-lit: ${LLVM_LIT_EXECUTABLE}")
+    else()
+      message(STATUS "llvm-lit not found - tests will not be runnable")
+    endif()
+  endif()
+
+  # Configure the lit site configuration.
+  configure_file(
+    ${CMAKE_CURRENT_SOURCE_DIR}/test/lit.site.cfg.py.in
+    ${CMAKE_CURRENT_BINARY_DIR}/test/lit.site.cfg.py
+    @ONLY)
+
+  # Lit test suite.
+  set(LIBHERBCEPTIONS_TEST_DEPENDS)
+  if(TARGET herbceptions_static)
+    list(APPEND LIBHERBCEPTIONS_TEST_DEPENDS herbceptions_static)
+  endif()
+
+  if(LLVM_LIT_EXECUTABLE)
+    # Find FileCheck.
+    find_program(FILECHECK_EXECUTABLE FileCheck
+      HINTS ${LLVM_TOOLS_DIR} $ENV{LLVM_TOOLS_DIR}
+      DOC "Path to FileCheck")
+    if(FILECHECK_EXECUTABLE)
+      message(STATUS "Found FileCheck: ${FILECHECK_EXECUTABLE}")
+    else()
+      message(STATUS "FileCheck not found - tests may fail")
+    endif()
+
+    add_custom_target(check-herbceptions
+      COMMAND ${LLVM_LIT_EXECUTABLE}
+        ${CMAKE_CURRENT_BINARY_DIR}/test
+        --verbose
+        --param cxx=${CMAKE_CXX_COMPILER}
+        --param filecheck=${FILECHECK_EXECUTABLE}
+      DEPENDS ${LIBHERBCEPTIONS_TEST_DEPENDS}
+      COMMENT "Running libherbceptions tests"
+      USES_TERMINAL)
+  endif()
+
+  # Legacy CTest support (kept for compatibility).
+  add_executable(herbceptions_domain_test test/domain_test.cpp)
+  target_link_libraries(herbceptions_domain_test PRIVATE herbceptions)
+  if(CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU")
+    target_compile_options(herbceptions_domain_test PRIVATE
+      -fherbceptions -fexceptions)
+  endif()
+  add_test(NAME herbceptions_domain_test COMMAND herbceptions_domain_test)
+endif()
+
+if(LIBHERBCEPTIONS_BUILD_FUZZERS AND NOT LIBHERBCEPTIONS_HEADERS_ONLY)
+  foreach(target herbceptions herbceptions_static)
+    target_compile_options(${target} PRIVATE -fsanitize=fuzzer-no-link)
+  endforeach()
+  function(add_herbceptions_fuzzer name)
+    add_executable(${name} fuzz/${name}.cpp)
+    target_include_directories(${name} PRIVATE
+      ${CMAKE_CURRENT_SOURCE_DIR}/src)
+    target_link_libraries(${name} PRIVATE herbceptions)
+    if(LIBHERBCEPTIONS_FUZZ_ENGINE)
+      target_compile_definitions(${name} PRIVATE
+        LIBHERBCEPTIONS_HAVE_FUZZ_ENGINE=1)
+      target_compile_options(${name} PRIVATE -fsanitize=fuzzer)
+      target_link_options(${name} PRIVATE -fsanitize=fuzzer)
+    endif()
+    if(CMAKE_SYSTEM_NAME STREQUAL "Windows")
+      target_link_libraries(${name} PRIVATE ntdll)
+    endif()
+  endfunction()
+
+  add_herbceptions_fuzzer(error_codes_fuzzer)
+  add_herbceptions_fuzzer(query_information_fuzzer)
+  add_herbceptions_fuzzer(tls_alert_fuzzer)
+  if(CMAKE_SYSTEM_NAME STREQUAL "Windows")
+    if(CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
+      add_herbceptions_fuzzer(msvc_exception_record_fuzzer)
+    else()
+      add_herbceptions_fuzzer(itanium_exception_record_fuzzer)
+    endif()
+  else()
+    add_herbceptions_fuzzer(itanium_exception_record_fuzzer)
+  endif()
+endif()
diff --git a/libherbceptions/fuzz/error_codes_fuzzer.cpp b/libherbceptions/fuzz/error_codes_fuzzer.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7fe152e5416f4e6fc115b6dc938563be614a8bd7
--- /dev/null
+++ b/libherbceptions/fuzz/error_codes_fuzzer.cpp
@@ -0,0 +1,112 @@
+//===--- error_codes_fuzzer.cpp - error domain code fuzzer ----------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Drives every available error domain's do_query_information (all queries x
+// all encodings), do_to_errc and pairwise do_equivalent with attacker
+// controlled codes. Everything here is memory safe by construction; the
+// point is to shake out formatting / conversion / table bugs.
+//
+//===----------------------------------------------------------------------===//
+
+#include "fuzz_harness.h"
+
+namespace {
+
+using ::std::error_domain_singleton;
+using ::std::error_query_information;
+using ::std::error_reporter_encoding;
+
+constexpr ::std::error_query_information kQueries[] = {
+    error_query_information::name,
+    error_query_information::message,
+    error_query_information::name_message,
+};
+
+constexpr ::std::error_reporter_encoding kEncodings[] = {
+    error_reporter_encoding::utf8,      error_reporter_encoding::utf16,
+    error_reporter_encoding::utf32,     error_reporter_encoding::gb18030,
+    error_reporter_encoding::utfebcdic,
+};
+
+void query_all(error_domain_singleton const *domain,
+               ::std::uint_least32_t code) noexcept {
+  herbceptions_fuzz::capture_ctx ctx;
+  for (auto const q : kQueries) {
+    for (auto const e : kEncodings) {
+      herbceptions_fuzz::reset(ctx);
+      domain->do_query_information(code, q, e, &ctx,
+                                   herbceptions_fuzz::capture_cookfun);
+    }
+  }
+}
+
+} // namespace
+
+extern "C" int LLVMFuzzerTestOneInput(::std::uint8_t const *data,
+                                      ::std::size_t size) {
+  if (size < 8) {
+    return 0;
+  }
+  auto const a{static_cast<::std::uint_least32_t>(
+      data[0] | (data[1] << 8u) | (data[2] << 16u) | (data[3] << 24u))};
+  auto const b{static_cast<::std::uint_least32_t>(
+      data[4] | (data[5] << 8u) | (data[6] << 16u) | (data[7] << 24u))};
+
+  query_all(::std::error_domains::__cxa_error_domain_posix(), a);
+  query_all(::std::error_domains::__cxa_error_domain_parse(), b);
+  query_all(::std::error_domains::__cxa_error_domain_cmath(), a ^ b);
+  query_all(::std::error_domains::__cxa_error_domain_http(), a);
+  // http codes worth hammering: registered statuses, boundary values, and
+  // attacker-controlled range extensions.
+  query_all(::std::error_domains::__cxa_error_domain_http(), 99u + (b % 500u));
+  query_all(::std::error_domains::__cxa_error_domain_http(), a | b);
+
+  // Cross-domain equivalence over the always-available domains.
+  {
+    error_domain_singleton const *const kDomains[] = {
+        ::std::error_domains::__cxa_error_domain_posix(),
+        ::std::error_domains::__cxa_error_domain_parse(),
+        ::std::error_domains::__cxa_error_domain_cmath(),
+        ::std::error_domains::__cxa_error_domain_http()};
+    for (auto const *d1 : kDomains) {
+      for (auto const *d2 : kDomains) {
+        d1->do_equivalent(a, d2, b);
+        d1->do_to_errc(a);
+      }
+    }
+  }
+
+#ifdef _WIN32
+  auto const *wine{::std::error_domains::__cxa_error_domain_wine()};
+  auto const *win32{::std::error_domains::__cxa_error_domain_win32()};
+  auto const *nt{::std::error_domains::__cxa_error_domain_nt()};
+  auto const *com{::std::error_domains::__cxa_error_domain_com()};
+
+  constexpr ::std::uint_least32_t kComFacilityNtBit{0x10000000u};
+  constexpr ::std::uint_least32_t kComFacilityWin32Base{0x80070000u};
+
+  query_all(wine, b);
+  query_all(win32, a);
+  query_all(nt, a);
+  query_all(nt, 0x80000000u | (a & 0x7FFFFFFFu));
+  query_all(com, b);
+  query_all(com, b | kComFacilityNtBit);
+  query_all(com, kComFacilityWin32Base | (a & 0xFFFFu));
+
+  // Cross-domain equivalence over the whole triangle plus posix/wine.
+  error_domain_singleton const *const domains[] = {
+      ::std::error_domains::__cxa_error_domain_posix(), wine, win32, nt, com};
+  for (auto const *d1 : domains) {
+    for (auto const *d2 : domains) {
+      d1->do_equivalent(a, d2, b);
+      d1->do_to_errc(a);
+    }
+  }
+#endif
+  return 0;
+}
diff --git a/libherbceptions/fuzz/fuzz_harness.h b/libherbceptions/fuzz/fuzz_harness.h
new file mode 100644
index 0000000000000000000000000000000000000000..0e3ea2f890ccf4947d50f2646dcc3e76b7fd3b8f
--- /dev/null
+++ b/libherbceptions/fuzz/fuzz_harness.h
@@ -0,0 +1,171 @@
+//===----------------------------------------------------------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#pragma once
+/*
+Shared plumbing for the libherbceptions fuzz targets: a bounded output
+collector plus a standalone replay driver used when the target is not
+linked against a fuzzing engine (build with LIBHERBCEPTIONS_FUZZ_ENGINE=ON
+to get a -fsanitize=fuzzer binary instead; then any corpus directory /
+single inputs work as usual).
+*/
+#include <herbceptions/error>
+
+#include <cstddef>
+#include <cstdint>
+
+namespace herbceptions_fuzz {
+
+inline constexpr ::std::size_t capture_capacity{8192};
+
+struct capture_ctx {
+  char buf[capture_capacity];
+  ::std::size_t len;
+};
+
+inline void reset(capture_ctx &ctx) noexcept {
+  ctx.len = 0;
+  ctx.buf[0] = '\0';
+}
+
+// Collector: appends every reported byte, truncating at capacity. Safe to
+// pass to any do_query_information.
+inline void capture_cookfun(void *cookie, ::std::io_scatter_t const *v,
+                            ::std::size_t n) noexcept {
+  auto *ctx{static_cast<capture_ctx *>(cookie)};
+  for (::std::size_t i = 0; i < n; ++i) {
+    auto const *base{static_cast<char const *>(v[i].base)};
+    for (::std::size_t j = 0; j < v[i].len; ++j) {
+      if (ctx->len + 1u == capture_capacity) {
+        return;
+      }
+      ctx->buf[ctx->len++] = base[j];
+    }
+  }
+  ctx->buf[ctx->len] = '\0';
+}
+
+} // namespace herbceptions_fuzz
+
+#ifndef LIBHERBCEPTIONS_HAVE_FUZZ_ENGINE
+
+/*
+Standalone driver: without arguments it replays stdin once. Otherwise:
+
+    prog <iterations> [seed files...]
+
+loads every seed file and then runs a self-contained mutation loop
+(bit flips, byte replacements, insertions, splices, truncations) over the
+seeds through LLVMFuzzerTestOneInput. A crash is a finding; rerun with the
+saved input to reproduce it.
+*/
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <vector>
+
+extern "C" int LLVMFuzzerTestOneInput(::std::uint8_t const *data,
+                                      ::std::size_t size);
+
+namespace herbceptions_fuzz {
+
+inline void mutate(::std::vector<::std::uint8_t> &v,
+                   ::std::mt19937_64 &rng) noexcept {
+  ::std::size_t const rounds{1u + rng() % 8u};
+  for (::std::size_t r = 0; r != rounds && !v.empty(); ++r) {
+    switch (rng() % 6u) {
+    case 0: { // bit flip
+      v[rng() % v.size()] ^= static_cast<::std::uint8_t>(1u << (rng() % 8u));
+      break;
+    }
+    case 1: { // random byte
+      v[rng() % v.size()] = static_cast<::std::uint8_t>(rng());
+      break;
+    }
+    case 2: { // interesting byte
+      constexpr ::std::uint8_t const kInteresting[]{0,   1,   0x7F, 0x80, 0xFF,
+                                                    'H', 'E', '.',  '?',  '@',
+                                                    '(', ')', '[',  ']',  '\\'};
+      v[rng() % v.size()] = kInteresting[static_cast<::std::size_t>(
+          rng() % (sizeof(kInteresting) / sizeof(kInteresting[0])))];
+      break;
+    }
+    case 3: { // truncate
+      if (v.size() > 1u) {
+        v.resize(1u + rng() % v.size());
+      }
+      break;
+    }
+    case 4: { // insert chunk of another size (caller keeps seeds)
+      break;
+    }
+    default: { // duplicate a byte somewhere
+      v.insert(v.begin() + static_cast<long>(rng() % v.size()),
+               v[rng() % v.size()]);
+      break;
+    }
+    }
+  }
+}
+
+} // namespace herbceptions_fuzz
+
+int main(int argc, char **argv) {
+  ::std::vector<::std::vector<::std::uint8_t>> seeds;
+  ::std::size_t iterations{0};
+  for (int i = 1; i < argc; ++i) {
+    if (i == 1) {
+      char *end{};
+      unsigned long long const parsed{::std::strtoull(argv[i], &end, 10)};
+      if (end != argv[i] && *end == '\0') {
+        iterations = static_cast<::std::size_t>(parsed);
+        continue;
+      }
+    }
+    ::std::FILE *f{::std::fopen(argv[i], "rb")};
+    if (f == nullptr) {
+      ::std::fprintf(stderr, "cannot open %s\n", argv[i]);
+      continue;
+    }
+    ::std::vector<::std::uint8_t> input;
+    char chunk[4096];
+    for (::std::size_t got{};
+         (got = ::std::fread(chunk, 1, sizeof(chunk), f)) != 0;) {
+      input.insert(input.end(), chunk, chunk + got);
+    }
+    ::std::fclose(f);
+    seeds.push_back(::std::move(input));
+  }
+
+  if (seeds.empty()) { // replay stdin once
+    ::std::vector<::std::uint8_t> input;
+    char chunk[4096];
+    for (::std::size_t got{};
+         (got = ::std::fread(chunk, 1, sizeof(chunk), stdin)) != 0;) {
+      input.insert(input.end(), chunk, chunk + got);
+    }
+    LLVMFuzzerTestOneInput(input.data(), input.size());
+    return 0;
+  }
+
+  ::std::mt19937_64 rng{0x20260823ull};
+  for (::std::size_t i = 0; i != iterations; ++i) {
+    ::std::vector<::std::uint8_t> input{seeds[rng() % seeds.size()]};
+    herbceptions_fuzz::mutate(input, rng);
+    LLVMFuzzerTestOneInput(input.data(), input.size());
+    if ((i + 1u) % 10000u == 0u) {
+      ::std::fprintf(stderr, "iter %zu\n", i + 1u);
+    }
+  }
+  ::std::fprintf(stderr, "done %zu iterations\n", iterations);
+  return 0;
+}
+
+#endif
diff --git a/libherbceptions/fuzz/itanium_exception_record_fuzzer.cpp b/libherbceptions/fuzz/itanium_exception_record_fuzzer.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..9e0939b12130dd24dfcb2ff73955057ece55128a
--- /dev/null
+++ b/libherbceptions/fuzz/itanium_exception_record_fuzzer.cpp
@@ -0,0 +1,139 @@
+//===--- itanium_exception_record_fuzzer.cpp - itanium EH fuzzer ---------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM
+// Exceptions. See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Feeds synthesized __cxa_exception headers to the itanium_exception_ptr
+// domain. The exception type is always one of a fixed set of REAL type_info
+// objects and the thrown object slot holds a REAL live exception, so every
+// path that reaches what() or the RTTI walk stays memory safe while the
+// fuzz input decides which paths get exercised.
+//
+//===----------------------------------------------------------------------===//
+
+#if !defined(_MSC_VER)
+
+#include "fuzz_harness.h"
+
+#include "../src/itanium_exception_ptr.h"
+
+#include <cstring>
+#include <new>
+#include <stdexcept>
+#include <system_error>
+
+namespace {
+
+constexpr ::std::size_t kBufSize{1u << 16u};
+
+alignas(16) char unsigned g_buf[kBufSize];
+
+void place_object(::std::uint8_t selector, void *obj) {
+  switch (selector & 3u) {
+  case 0:
+    ::new (obj)::std::runtime_error("fuzz");
+    break;
+  case 1:
+    ::new (obj)::std::logic_error("fuzz");
+    break;
+  case 2:
+    ::new (obj)::std::system_error(
+        ::std::error_code(EACCES, ::std::generic_category()));
+    break;
+  default:
+    ::new (obj)::std::out_of_range("fuzz");
+    break;
+  }
+}
+
+::std::type_info const &type_for(::std::uint8_t selector) {
+  switch (selector & 3u) {
+  case 0:
+    return typeid(::std::runtime_error);
+  case 1:
+    return typeid(::std::logic_error);
+  case 2:
+    return typeid(::std::system_error);
+  default:
+    return typeid(::std::out_of_range);
+  }
+}
+
+} // namespace
+
+extern "C" int LLVMFuzzerTestOneInput(::std::uint8_t const *data,
+                                      ::std::size_t size) {
+  if (size < 8 || data[0] != 'I' || data[1] != 'T') {
+    return 0;
+  }
+
+  for (::std::size_t i = 0; i != kBufSize; ++i) {
+    g_buf[i] = 0;
+  }
+
+  ::std::size_t const thrown_off{(sizeof(itanium_cxa_exception) + 15u) &
+                                 ~::std::size_t{15u}};
+  auto *hdr{reinterpret_cast<itanium_cxa_exception *>(g_buf)};
+  void *const obj{g_buf + thrown_off};
+  // The header's exceptionType is the domain's ONLY source of truth for
+  // the object's dynamic type — a header claiming a different type than
+  // the object placed here would make downstream type-driven reads
+  // (system_error::code(), what()) read the wrong layout. Keep the
+  // selector shared so the fabricated record stays self-consistent.
+  place_object(data[2], obj);
+
+  hdr->reserve = nullptr;
+  hdr->referenceCount = 1;
+  hdr->exceptionType = const_cast<::std::type_info *>(&type_for(data[2]));
+  hdr->exceptionDestructor = nullptr;
+  hdr->unexpectedHandler = nullptr;
+  hdr->terminateHandler = nullptr;
+  hdr->nextException = nullptr;
+  hdr->handlerCount = 0;
+  hdr->handlerSwitchValue = 0;
+  hdr->actionRecord = nullptr;
+  hdr->languageSpecificData = nullptr;
+  hdr->catchTemp = nullptr;
+  hdr->adjustedPtr = nullptr;
+  hdr->unwindHeader.exception_class = 0x002B2B4343554E47ull; // "GNUCC++\\0"
+
+  herbceptions_fuzz::capture_ctx ctx;
+  auto const cd{reinterpret_cast<::std::size_t>(obj)};
+  constexpr ::std::error_query_information kQueries[] = {
+      ::std::error_query_information::name,
+      ::std::error_query_information::message,
+      ::std::error_query_information::name_message,
+  };
+  constexpr ::std::error_reporter_encoding kEncodings[] = {
+      ::std::error_reporter_encoding::utf8,
+      ::std::error_reporter_encoding::utf16,
+      ::std::error_reporter_encoding::utf32,
+      ::std::error_reporter_encoding::gb18030,
+      ::std::error_reporter_encoding::utfebcdic,
+  };
+  auto const *domain{
+      ::std::error_domains::__cxa_error_domain_itanium_exception_ptr()};
+  for (auto const q : kQueries) {
+    for (auto const e : kEncodings) {
+      herbceptions_fuzz::reset(ctx);
+      domain->do_query_information(cd, q, e, &ctx,
+                                   herbceptions_fuzz::capture_cookfun);
+    }
+  }
+  domain->do_to_errc(cd);
+  // The placed exception owns its what() string; destroy it so the
+  // allocation doesn't leak between inputs.
+  static_cast<::std::exception *>(obj)->~exception();
+  return 0;
+}
+
+#else
+
+extern "C" int LLVMFuzzerTestOneInput(::std::uint8_t const *, ::std::size_t) {
+  return 0;
+}
+
+#endif
diff --git a/libherbceptions/fuzz/msvc_exception_record_fuzzer.cpp b/libherbceptions/fuzz/msvc_exception_record_fuzzer.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f5fb019fd6a7c23d5128976711d45d2250210c39
--- /dev/null
+++ b/libherbceptions/fuzz/msvc_exception_record_fuzzer.cpp
@@ -0,0 +1,222 @@
+//===--- msvc_exception_record_fuzzer.cpp - MSVC EH record fuzzer ---------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM
+// Exceptions. See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Feeds synthesized (possibly hostile) MSVC C++ EH EXCEPTION_RECORDs to the
+// msvc_exception_ptr domain: type info table walks, the gperf name matcher,
+// the what() dispatch and the system_error prefix reads all run against
+// fuzz-controlled structures laid out inside a fixed buffer.
+//
+// Real C++ exception objects are placement-new'ed into the object slot, so
+// every path that reaches what() or the error_code prefix stays memory safe;
+// the fuzz input controls the EH plumbing (entry count, RVAs, mangled names,
+// this-adjustor offsets) that decides which paths get taken.
+//
+//===----------------------------------------------------------------------===//
+
+#if defined(_MSC_VER) && defined(_WIN32)
+
+#include "fuzz_harness.h"
+
+#include <windows.h>
+#undef min
+#undef max
+
+#include <cstring>
+#include <new>
+#include <stdexcept>
+#include <system_error>
+
+namespace {
+
+// Mirrors of the runtime's private EH ABI views
+// (src/msvc_exception_ptr.cpp). Keep in sync with those definitions.
+struct msvc_cxx_exception_type {
+  ::std::uint_least32_t flags;
+  ::std::uint_least32_t destructor;
+  ::std::uint_least32_t custom_handler;
+  ::std::uint_least32_t type_info_table;
+};
+struct this_ptr_offsets {
+  ::std::int_least32_t this_offset;
+  ::std::int_least32_t vbase_descr;
+  ::std::int_least32_t vbase_offset;
+};
+struct cxx_type_info {
+  ::std::uint_least32_t flags;
+  ::std::uint_least32_t type_info; // RVA to std::type_info
+  this_ptr_offsets offsets;
+  ::std::uint_least32_t size;
+  ::std::uint_least32_t copy_ctor;
+};
+struct cxx_type_info_table {
+  ::std::uint_least32_t count;
+  ::std::uint_least32_t info[10];
+};
+struct msvc_raw_type_info {
+  void *vtable;
+  char *name;
+  char mangled[128];
+};
+
+constexpr ::std::size_t kBufSize{1u << 16u};
+constexpr ::std::uintptr_t kEtOff{0x1000};
+constexpr ::std::uintptr_t kTblOff{0x2000};
+constexpr ::std::uintptr_t kCtiOff{0x3000};
+constexpr ::std::uintptr_t kCtiStride{0x80};
+constexpr ::std::uintptr_t kRawOff{0x4000};
+constexpr ::std::uintptr_t kRawStride{0x100};
+constexpr ::std::uintptr_t kObjOff{0x6000};
+constexpr unsigned kMaxEntries{5};
+
+alignas(16) char unsigned g_buf[kBufSize];
+
+void place_object(::std::uint8_t selector) {
+  switch (selector & 3u) {
+  case 0:
+    ::new (g_buf + kObjOff)::std::runtime_error("fuzz");
+    break;
+  case 1:
+    ::new (g_buf + kObjOff)::std::logic_error("fuzz");
+    break;
+  case 2:
+    ::new (g_buf + kObjOff)::std::system_error(
+        ::std::error_code(EACCES, ::std::generic_category()));
+    break;
+  default:
+    ::new (g_buf + kObjOff)::std::out_of_range("fuzz");
+    break;
+  }
+}
+
+void copy_mangled(msvc_raw_type_info *raw, ::std::uint8_t const *data,
+                  ::std::size_t size) noexcept {
+  ::std::size_t const n{size < 127 ? size : 127};
+  for (::std::size_t i = 0; i != n; ++i) {
+    raw->mangled[i] = static_cast<char>(data[i]);
+  }
+  raw->mangled[n] = '\0';
+}
+
+void seed_mangled(msvc_raw_type_info *raw, char const *name) noexcept {
+  unsigned i = 0;
+  for (; name[i] != '\0'; ++i) {
+    raw->mangled[i] = name[i];
+  }
+  raw->mangled[i] = '\0';
+}
+
+void run_queries(::std::error_domain_singleton const *domain, void *storage) {
+  herbceptions_fuzz::capture_ctx ctx;
+  auto const cd{reinterpret_cast<::std::size_t>(&storage)};
+  constexpr ::std::error_query_information kQueries[] = {
+      ::std::error_query_information::name,
+      ::std::error_query_information::message,
+      ::std::error_query_information::name_message,
+  };
+  constexpr ::std::error_reporter_encoding kEncodings[] = {
+      ::std::error_reporter_encoding::utf8,
+      ::std::error_reporter_encoding::utf16,
+      ::std::error_reporter_encoding::utf32,
+      ::std::error_reporter_encoding::gb18030,
+      ::std::error_reporter_encoding::utfebcdic,
+  };
+  for (auto const q : kQueries) {
+    for (auto const e : kEncodings) {
+      herbceptions_fuzz::reset(ctx);
+      domain->do_query_information(cd, q, e, &ctx,
+                                   herbceptions_fuzz::capture_cookfun);
+    }
+  }
+  domain->do_to_errc(cd);
+}
+
+} // namespace
+
+extern "C" int LLVMFuzzerTestOneInput(::std::uint8_t const *data,
+                                      ::std::size_t size) {
+  if (size < 16 || data[0] != 'H' || data[1] != 'E') {
+    return 0;
+  }
+
+  for (::std::size_t i = 0; i != kBufSize; ++i) {
+    g_buf[i] = 0;
+  }
+  place_object(data[3]);
+
+  auto *et{reinterpret_cast<msvc_cxx_exception_type *>(g_buf + kEtOff)};
+  auto *tbl{reinterpret_cast<cxx_type_info_table *>(g_buf + kTblOff)};
+
+  unsigned const entries{static_cast<unsigned>(data[2] % kMaxEntries) + 1u};
+  tbl->count = entries;
+
+  et->flags = 0;
+  et->destructor = 0;
+  et->custom_handler = 0;
+  et->type_info_table = static_cast<::std::uint_least32_t>(kTblOff);
+
+  // The exact mangled names the runtime searches for, seeded on demand so
+  // the what() dispatch and the gperf/system_error paths stay reachable.
+  char const kWhatName[]{".?AVexception@stdext@@"};
+  char const kSysErrName[]{".?AV_System_error@std@@"};
+  bool const seed_what{(data[5] & 1u) != 0};
+  bool const seed_syserr{(data[5] & 2u) != 0};
+
+  for (unsigned i = 0; i < entries; ++i) {
+    auto *cti{
+        reinterpret_cast<cxx_type_info *>(g_buf + kCtiOff + i * kCtiStride)};
+    cti->flags = 0;
+    cti->offsets.this_offset =
+        static_cast<::std::int_least32_t>(static_cast<signed char>(data[9])) *
+        4;
+    cti->offsets.vbase_descr = -1;
+    cti->offsets.vbase_offset = 0;
+    cti->size = 512;
+    cti->copy_ctor = 0;
+    // Bounded jitter keeps the RVA inside the raw type info region while
+    // still letting the fuzzer explore misalignment / wrong-slot choices.
+    ::std::uintptr_t const target{kRawOff + i * kRawStride +
+                                  static_cast<::std::uintptr_t>(data[4] % 4u) *
+                                      32u};
+    cti->type_info = static_cast<::std::uint_least32_t>(target);
+
+    auto *raw{reinterpret_cast<msvc_raw_type_info *>(g_buf + target)};
+    raw->vtable = nullptr;
+    raw->name = nullptr;
+    ::std::size_t const payload_off{10 + i * 8};
+    if (seed_what && i == data[6] % entries) {
+      seed_mangled(raw, kWhatName);
+    } else if (seed_syserr && i == data[7] % entries) {
+      seed_mangled(raw, kSysErrName);
+    } else if (payload_off < size) {
+      copy_mangled(raw, data + payload_off, size - payload_off);
+    }
+  }
+
+  EXCEPTION_RECORD rec{};
+  rec.ExceptionCode = 0xe06d7363; // MSVC C++ EH
+  rec.NumberParameters = 4;
+  rec.ExceptionInformation[0] = 0x19930520;
+  rec.ExceptionInformation[1] =
+      reinterpret_cast<::std::uintptr_t>(g_buf + kObjOff);
+  rec.ExceptionInformation[2] =
+      reinterpret_cast<::std::uintptr_t>(g_buf + kEtOff);
+  rec.ExceptionInformation[3] = 0;
+
+  void *storage{&rec};
+  run_queries(::std::error_domains::__cxa_error_domain_msvc_exception_ptr(),
+              storage);
+  return 0;
+}
+
+#else
+
+extern "C" int LLVMFuzzerTestOneInput(::std::uint8_t const *, ::std::size_t) {
+  return 0;
+}
+
+#endif
diff --git a/libherbceptions/fuzz/query_information_fuzzer.cpp b/libherbceptions/fuzz/query_information_fuzzer.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..17fb9664ac4592f72c77020195dc1fb1e078e76d
--- /dev/null
+++ b/libherbceptions/fuzz/query_information_fuzzer.cpp
@@ -0,0 +1,227 @@
+//===--- query_information_fuzzer.cpp - query-information buffer fuzzer --===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM
+// Exceptions. See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Feeds fuzz-controlled emit programs to
+// ::std::error_domains::__cxa_error_query_information_create through a
+// synthetic domain: the input picks the number of emit calls, the scatter count
+// per call and every fragment's bytes and length (including zero), so the
+// append sink is exercised across its growth, empty, NUL-pad and pass-through
+// paths. The returned scatter is verified byte-for-byte against a shadow copy
+// of everything emitted, then cloned and freed in fuzz-chosen order. Real
+// domains are also driven through the same create/clone/free cycle.
+//
+//===----------------------------------------------------------------------===//
+
+#include "fuzz_harness.h"
+
+#include <cstdlib>
+#include <cstring>
+
+namespace {
+
+constexpr ::std::size_t kMaxFrag{4096};
+constexpr ::std::size_t kMaxTotal{1u << 18u};
+constexpr ::std::size_t kMaxScatters{8};
+
+// Per-input program state. The input bytes double as the fragment source:
+// control bytes pick scatter counts and lengths, the remaining bytes are
+// the fragment payloads. `shadow` is only read back up to `emitted`, so it
+// does not need clearing between inputs.
+struct hook_state {
+  ::std::uint8_t const *cur{};
+  ::std::uint8_t const *end{};
+  ::std::size_t emitted{};
+  ::std::size_t code_seen{};
+  ::std::error_query_information info_seen{};
+  ::std::error_reporter_encoding enc_seen{};
+  char unsigned shadow[kMaxTotal];
+};
+
+hook_state g_state;
+
+[[noreturn]] void fail() noexcept { ::std::abort(); }
+
+::std::uint8_t next_byte() noexcept {
+  return g_state.cur == g_state.end ? ::std::uint8_t{} : *g_state.cur++;
+}
+
+::std::size_t next_size(::std::size_t bound) noexcept {
+  return ((static_cast<::std::size_t>(next_byte()) << 8u) | next_byte()) %
+         bound;
+}
+
+void fuzz_query_information(
+    ::std::size_t code, ::std::error_query_information info,
+    ::std::error_reporter_encoding enc, void *cookie,
+    ::std::error_reporter_io_cookie_function emit) noexcept {
+  // The runtime must forward these unmodified.
+  g_state.code_seen = code;
+  g_state.info_seen = info;
+  g_state.enc_seen = enc;
+  ::std::io_scatter_t scatters[kMaxScatters];
+  while (g_state.cur != g_state.end) {
+    ::std::size_t const n{next_size(kMaxScatters + 1u)};
+    for (::std::size_t i{}; i != n; ++i) {
+      ::std::size_t want{next_size(kMaxFrag)};
+      // Consume the flag byte before measuring the remaining input —
+      // avail_in must be computed after every control byte for this
+      // scatter, otherwise cur can advance past end.
+      bool const degenerate{(next_byte() & 31u) == 0u};
+      if (degenerate) {
+        // Occasionally a degenerate scatter: zero len, sometimes null base.
+        scatters[i] = {(next_byte() & 1u) != 0u ? nullptr : g_state.cur,
+                       ::std::size_t{}};
+        continue;
+      }
+      ::std::size_t const avail_in{
+          static_cast<::std::size_t>(g_state.end - g_state.cur)};
+      ::std::size_t const avail_cap{kMaxTotal - g_state.emitted};
+      if (want > avail_in) {
+        want = avail_in;
+      }
+      if (want > avail_cap) {
+        want = avail_cap;
+      }
+      scatters[i] = {g_state.cur, want};
+      __builtin_memcpy(g_state.shadow + g_state.emitted, g_state.cur, want);
+      g_state.emitted += want;
+      g_state.cur += want;
+    }
+    emit(cookie, scatters, n);
+  }
+}
+
+// Aggregate-initialized: only do_query_information is set.
+::std::error_domain_singleton const g_domain{
+    nullptr, nullptr, fuzz_query_information, nullptr, nullptr};
+::std::error_domain_singleton const g_hookless_domain{};
+
+void check_empty(::std::io_scatter_t const &s) noexcept {
+  if (s.len != 0 || s.base == nullptr) {
+    fail();
+  }
+  // The empty result must still read as a NUL-terminated string in the
+  // widest supported encoding (utf32): the first char32_t is zero.
+  if (*static_cast<char32_t const *>(s.base) != 0) {
+    fail();
+  }
+}
+
+void check_full(::std::io_scatter_t const &s, char unsigned const *expect,
+                ::std::size_t expect_len) noexcept {
+  if (s.len != expect_len || s.base == nullptr) {
+    fail();
+  }
+  if (expect_len == 0) {
+    check_empty(s);
+    return;
+  }
+  if (__builtin_memcmp(s.base, expect, expect_len) != 0) {
+    fail();
+  }
+  // Every nonempty buffer carries a 4-byte NUL pad — inside the
+  // allocation, so this read is also an ASan bounds check.
+  auto const *p{static_cast<char unsigned const *>(s.base)};
+  for (::std::size_t i{}; i != sizeof(char32_t); ++i) {
+    if (p[expect_len + i] != 0) {
+      fail();
+    }
+  }
+}
+
+} // namespace
+
+extern "C" int LLVMFuzzerTestOneInput(::std::uint8_t const *data,
+                                      ::std::size_t size) {
+  if (size < 8) {
+    return 0;
+  }
+  g_state.cur = data;
+  g_state.end = data + size - 1;
+  g_state.emitted = 0;
+  g_state.code_seen = 0;
+  ::std::uint8_t const ops{data[size - 1]};
+
+  // Header bytes: the code/encoding/info arguments, deliberately allowing
+  // out-of-range enum values — the runtime forwards them verbatim.
+  ::std::size_t code{};
+  for (::std::size_t i{}; i != sizeof(::std::size_t); ++i) {
+    code = (code << 8u) | next_byte();
+  }
+  auto const enc{static_cast<::std::error_reporter_encoding>(next_byte())};
+  auto const info{static_cast<::std::error_query_information>(next_byte())};
+
+  // Synthetic domain: the emit program runs over whatever input is left.
+  auto const res{::std::error_domains::__cxa_error_query_information_create(
+      &g_domain, code, enc, info)};
+  if (g_state.code_seen != code || g_state.enc_seen != enc ||
+      g_state.info_seen != info) {
+    fail();
+  }
+  // g_state.emitted/shadow are complete only now that the hook has run.
+  check_full(res, g_state.shadow, g_state.emitted);
+
+  // Full clone must be byte-identical and independently owned.
+  auto const dup{::std::error_domains::__cxa_error_query_information_clone(
+      res.base, res.len)};
+  check_full(dup, g_state.shadow, res.len);
+
+  // Cloning a shorter prefix is legal: the caller owns len bytes.
+  auto const prelen{(ops >> 3u) % (res.len + 1u)};
+  auto const pre{::std::error_domains::__cxa_error_query_information_clone(
+      res.base, prelen)};
+  check_full(pre, g_state.shadow, prelen);
+
+  // clone() on non-buffer inputs has fixed contracts.
+  auto const null_clone{
+      ::std::error_domains::__cxa_error_query_information_clone(nullptr,
+                                                                ops | 1u)};
+  if (null_clone.base != nullptr || null_clone.len != 0) {
+    fail();
+  }
+  check_empty(
+      ::std::error_domains::__cxa_error_query_information_clone(res.base, 0));
+
+  // free() ignores len==0 outright — even for non-heap bases.
+  {
+    char canary[8]{};
+    ::std::error_domains::__cxa_error_query_information_free(canary, 0);
+    for (char const c : canary) {
+      if (c != 0) {
+        fail();
+      }
+    }
+  }
+
+  if ((ops & 1u) != 0u) {
+    ::std::error_domains::__cxa_error_query_information_free(dup.base, dup.len);
+    ::std::error_domains::__cxa_error_query_information_free(res.base, res.len);
+  } else {
+    ::std::error_domains::__cxa_error_query_information_free(res.base, res.len);
+    ::std::error_domains::__cxa_error_query_information_free(dup.base, dup.len);
+  }
+  ::std::error_domains::__cxa_error_query_information_free(pre.base, pre.len);
+
+  // Degenerate domains: no hook, and no domain at all.
+  check_empty(::std::error_domains::__cxa_error_query_information_create(
+      &g_hookless_domain, code, enc, info));
+  check_empty(::std::error_domains::__cxa_error_query_information_create(
+      nullptr, code, enc, info));
+
+  // A real domain through the same create/clone/free cycle.
+  auto const real{::std::error_domains::__cxa_error_query_information_create(
+      ::std::error_domains::__cxa_error_domain_posix(), code, enc, info)};
+  auto const real_dup{::std::error_domains::__cxa_error_query_information_clone(
+      real.base, real.len)};
+  check_full(real_dup, static_cast<char unsigned const *>(real.base), real.len);
+  ::std::error_domains::__cxa_error_query_information_free(real_dup.base,
+                                                           real_dup.len);
+  ::std::error_domains::__cxa_error_query_information_free(real.base, real.len);
+
+  return 0;
+}
diff --git a/libherbceptions/fuzz/tls_alert_fuzzer.cpp b/libherbceptions/fuzz/tls_alert_fuzzer.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..5c08bbf09c160d74434bdd7e53fbeea5a1af1696
--- /dev/null
+++ b/libherbceptions/fuzz/tls_alert_fuzzer.cpp
@@ -0,0 +1,91 @@
+//===--- tls_alert_fuzzer.cpp - tls alert domain code fuzzer --------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Drives the tls alert domain's do_query_information (all queries x all
+// encodings), do_to_errc and do_equivalent with attacker-controlled packed
+// (level, description) codes. The description byte is the IANA TLS Alerts
+// value; the level byte is attacker-controlled and only 1/2 are assigned,
+// so every unlisted level/description combination gets exercised.
+// Everything here is memory safe by construction; the point is to shake
+// out formatting / conversion / table bugs.
+//
+//===----------------------------------------------------------------------===//
+
+#include "fuzz_harness.h"
+
+namespace {
+
+using ::std::error_domain_singleton;
+using ::std::error_query_information;
+using ::std::error_reporter_encoding;
+
+constexpr ::std::error_query_information kQueries[] = {
+    error_query_information::name,
+    error_query_information::message,
+    error_query_information::name_message,
+};
+
+constexpr ::std::error_reporter_encoding kEncodings[] = {
+    error_reporter_encoding::utf8,      error_reporter_encoding::utf16,
+    error_reporter_encoding::utf32,     error_reporter_encoding::gb18030,
+    error_reporter_encoding::utfebcdic,
+};
+
+void query_all(error_domain_singleton const *domain,
+               ::std::uint_least32_t code) noexcept {
+  herbceptions_fuzz::capture_ctx ctx;
+  for (auto const q : kQueries) {
+    for (auto const e : kEncodings) {
+      herbceptions_fuzz::reset(ctx);
+      domain->do_query_information(code, q, e, &ctx,
+                                   herbceptions_fuzz::capture_cookfun);
+    }
+  }
+}
+
+} // namespace
+
+extern "C" int LLVMFuzzerTestOneInput(::std::uint8_t const *data,
+                                      ::std::size_t size) {
+  if (size < 8) {
+    return 0;
+  }
+  auto const a{static_cast<::std::uint_least32_t>(
+      data[0] | (data[1] << 8u) | (data[2] << 16u) | (data[3] << 24u))};
+  auto const b{static_cast<::std::uint_least32_t>(
+      data[4] | (data[5] << 8u) | (data[6] << 16u) | (data[7] << 24u))};
+
+  auto const *tls{::std::error_domains::__cxa_error_domain_tls()};
+
+  // Whole 32-bit space: out-of-range level bits above byte 0 and values
+  // beyond the wire bytes must format without overflowing the buffers.
+  query_all(tls, a);
+  query_all(tls, b);
+
+  // Codes worth hammering: both assigned levels against every description
+  // byte, then fuzz level/description bytes through the full 16-bit pair
+  // range.
+  for (::std::uint_least32_t d{}; d != 256u; ++d) {
+    query_all(tls, (1u << 8) | d);
+    query_all(tls, (2u << 8) | d);
+  }
+  query_all(tls, ((a & 0xffu) << 8) | (b & 0xffu));
+  query_all(tls, (a & 0xffffu));
+  query_all(tls, a | (b << 16));
+
+  // Equivalence: same domain cross-code, and tls vs posix through
+  // do_to_errc on both sides.
+  tls->do_equivalent(a, tls, b);
+  auto const *posix{::std::error_domains::__cxa_error_domain_posix()};
+  tls->do_equivalent(a, posix, b);
+  posix->do_equivalent(a, tls, b);
+  tls->do_to_errc(a);
+  tls->do_to_errc(b);
+
+  return 0;
+}
