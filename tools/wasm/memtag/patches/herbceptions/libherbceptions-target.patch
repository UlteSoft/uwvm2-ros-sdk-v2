+inline char const *get_msvc_exception_what(void *obj) noexcept {
+  using what_fn =
+      char const *(__thiscall *)(void *) noexcept; // or __cdecl on x64
+  void *vtbl = *reinterpret_cast<void **>(obj);
+  return (reinterpret_cast<what_fn *>(vtbl)[1])(obj);
+}
