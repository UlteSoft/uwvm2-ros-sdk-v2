+extern "C" __declspec(dllimport) void **__cdecl __current_exception() noexcept;
+#else
+using msvc_current_exception_fn = void **(__cdecl *)() noexcept;
+
+using msvc_wide_ptr
+#if __has_cpp_attribute(__gnu__::__may_alias__)
+    [[__gnu__::__may_alias__]]
+#endif
+    = wchar_t const *;
