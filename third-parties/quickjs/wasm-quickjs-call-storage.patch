+/* Charge transient call storage to the runtime's existing stack budget.
+   The generator itself retains ownership of suspended frames. */
+static void* js_call_storage_alloc(JSContext* ctx, size_t bytes)
+{
+    JSRuntime* rt = ctx->rt;
+    size_t limit = rt->stack_size ? rt->stack_size : SIZE_MAX;
+    if (rt->call_storage_bytes > limit || bytes > limit - rt->call_storage_bytes ||
+        bytes > SIZE_MAX - JS_MALLOC_ALIGN - sizeof(JSMallocLargeBlockHeader))
+    {
+        JS_ThrowInternalError(ctx, "call stack storage limit exceeded");
+        return NULL;
+    }
+    void* storage = js_malloc(ctx, bytes);
+    if (storage)
+        rt->call_storage_bytes += bytes;
+    return storage;
+}
+
+static void js_call_storage_free(JSRuntime* rt, void* storage, size_t bytes)
+{
+    if (storage)
+    {
+        assert(rt->call_storage_bytes >= bytes);
+        rt->call_storage_bytes -= bytes;
+        js_free_rt(rt, storage);
+    }
+}
