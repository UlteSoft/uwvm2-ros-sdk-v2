+    /** @brief Lower the Java shift operators to fixed-width Clang Wasm C expressions. */
+    private void generateJavaShift(BinaryExpr expr) {
+        boolean isLong = expr.getType() == OperationType.LONG;
+        String signedType = isLong ? "int64_t" : "int32_t";
+        // Java masks the distance even for negative or oversized counts.
+        // Shift left through the unsigned type so high bits and negative values do not cause C UB.
+        String operandType = expr.getOperation() == BinaryOperation.RIGHT_SHIFT ? signedType : "u" + signedType;
+        writer.print("((").print(signedType).print(") ((").print(operandType).print(") (");
+        expr.getFirstOperand().acceptVisitor(this);
+        writer.print(expr.getOperation() == BinaryOperation.LEFT_SHIFT ? ") << " : ") >> ");
+        writer.print("((uint32_t) (");
+        expr.getSecondOperand().acceptVisitor(this);
+        writer.print(isLong ? ") & 63u)))" : ") & 31u)))");
+    }
