+//===----------------------------------------------------------------------===//
+// WebAssembly single-value C ABI, shared by wasm32 and wasm64.
+//===----------------------------------------------------------------------===//
+
+namespace {
+/// @brief Marshal Fortran interfaces using Clang's ordinary Wasm C ABI.
+/// @details Aggregates use indirect arguments/results except for one scalar
+/// field with no trailing padding. Character lengths follow the pointer width.
+template <int Width>
+struct TargetWasm : public GenericTarget<TargetWasm<Width>> {
+  using Base = GenericTarget<TargetWasm<Width>>;
+  using Base::Base;
+  using AT = CodeGenSpecifics::Attributes;
+  static constexpr int defaultWidth = Width;
+
+  /// @brief Find the scalar representation of a C-compatible single-field type.
+  /// @param loc Original interface location for layout diagnostics.
+  /// @param type Field or record to classify without changing its memory layout.
+  /// @return Scalar coercion type, or an empty type for an indirect aggregate.
+  mlir::Type singleElement(mlir::Location loc, mlir::Type type) const {
+    if (auto record = mlir::dyn_cast<fir::RecordType>(type)) {
+      mlir::Type element;
+      for (const auto &field : record.getTypeList()) {
+        auto [size, alignment] = fir::getTypeSizeAndAlignmentOrCrash(
+            loc, field.second, this->getDataLayout(), this->kindMap);
+        if (size == 0)
+          continue;
+        if (element)
+          return {};
+        element = singleElement(loc, field.second);
+        if (!element)
+          return {};
+      }
+      if (!element)
+        return {};
+      auto [recordSize, recordAlignment] = fir::getTypeSizeAndAlignmentOrCrash(
+          loc, record, this->getDataLayout(), this->kindMap);
+      auto [elementSize, elementAlignment] = fir::getTypeSizeAndAlignmentOrCrash(
+          loc, element, this->getDataLayout(), this->kindMap);
+      return recordSize == elementSize ? element : mlir::Type{};
+    }
+    if (auto sequence = mlir::dyn_cast<fir::SequenceType>(type)) {
+      for (auto extent : sequence.getShape())
+        if (extent != 1)
+          return {};
+      return singleElement(loc, sequence.getEleTy());
+    }
+    if (auto character = mlir::dyn_cast<fir::CharacterType>(type)) {
+      if (character.getLen() != 1)
+        return {};
+      return mlir::IntegerType::get(
+          type.getContext(), this->kindMap.getCharacterBitsize(character.getFKind()));
+    }
+    if (auto logical = mlir::dyn_cast<fir::LogicalType>(type))
+      return mlir::IntegerType::get(
+          type.getContext(), this->kindMap.getLogicalBitsize(logical.getFKind()));
+    if (mlir::isa<mlir::ComplexType>(type))
+      return {};
+    return type;
+  }
+
+  /// @brief Pass or return an ordinary C aggregate through its natural storage.
+  /// @param loc Original interface location for layout diagnostics.
+  /// @param type Aggregate's genuine Fortran memory type.
+  /// @param result Select a hidden sret pointer instead of a byval argument.
+  /// @return Exact FIR argument/result marshalling and alignment attributes.
+  CodeGenSpecifics::Marshalling indirect(mlir::Location loc, mlir::Type type,
+                                        bool result) const {
+    auto [size, alignment] = fir::getTypeSizeAndAlignmentOrCrash(
+        loc, type, this->getDataLayout(), this->kindMap);
+    CodeGenSpecifics::Marshalling marshal;
+    marshal.emplace_back(fir::ReferenceType::get(type),
+                         AT{alignment, /*byval=*/!result, /*sret=*/result});
+    return marshal;
+  }
+
+  CodeGenSpecifics::Marshalling
+  complexArgumentType(mlir::Location loc, mlir::Type element) const override {
+    return complexType(loc, element, /*result=*/false);
+  }
+
+  CodeGenSpecifics::Marshalling
+  complexReturnType(mlir::Location loc, mlir::Type element) const override {
+    return complexType(loc, element, /*result=*/true);
+  }
+
+  /// @brief Keep both complex components together in naturally aligned storage.
+  /// @details The ordinary Wasm ABI does not use experimental multivalue tuples.
+  CodeGenSpecifics::Marshalling complexType(mlir::Location loc,
+                                           mlir::Type element,
+                                           bool result) const {
+    auto [size, alignment] = fir::getTypeSizeAndAlignmentOrCrash(
+        loc, element, this->getDataLayout(), this->kindMap);
+    auto memory = this->complexMemoryType(element);
+    CodeGenSpecifics::Marshalling marshal;
+    marshal.emplace_back(fir::ReferenceType::get(memory),
+                         AT{alignment, /*byval=*/!result, /*sret=*/result});
+    return marshal;
+  }
+
+  /// @brief Apply the single-element exception or the ordinary indirect ABI.
+  CodeGenSpecifics::Marshalling recordType(mlir::Location loc,
+                                          fir::RecordType type,
+                                          bool result) const {
+    if (auto element = singleElement(loc, type)) {
+      CodeGenSpecifics::Marshalling marshal;
+      marshal.emplace_back(element, AT{});
+      return marshal;
+    }
+    return indirect(loc, type, result);
+  }
+
+  CodeGenSpecifics::Marshalling
+  structArgumentType(mlir::Location loc, fir::RecordType type,
+                     const CodeGenSpecifics::Marshalling &) const override {
+    return recordType(loc, type, /*result=*/false);
+  }
+
+  CodeGenSpecifics::Marshalling
+  structReturnType(mlir::Location loc, fir::RecordType type) const override {
+    return recordType(loc, type, /*result=*/true);
+  }
+};
+} // namespace
