+/// Model the target ISO C descriptor rather than reflecting host size_t and
+/// ptrdiff_t. The data layout comes from the module that is being lowered.
+template <int Field>
+static mlir::Type getTargetDescFieldType(mlir::MLIRContext *context,
+                                         const mlir::DataLayout &layout) {
+  if constexpr (Field == kElemLenPosInBox || Field == kDimsPosInBox) {
+    auto pointer = mlir::LLVM::LLVMPointerType::get(context);
+    auto bits = layout.getTypeSizeInBits(pointer).getFixedValue();
+    auto index = mlir::IntegerType::get(context, bits);
+    if constexpr (Field == kDimsPosInBox)
+      return mlir::LLVM::LLVMArrayType::get(index, 3);
+    return index;
+  }
+  return getDescFieldTypeModel<Field>()(context);
+}
