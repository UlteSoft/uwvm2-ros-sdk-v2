/** @file ros-abi.dox
 * @brief Raw ROSv2 imports and guest memory contracts.
 */

/** @fn uint32_t wr_abi(void)
 * @brief Returns major 2 only when explicitly exposed; errors encoded in same i32 result.
 * @details Guest import <tt>uwvm_ros_v2.abi</tt>.
 * Wire format: special_signature.
 * Request fields: none.
 * Result fields: major (u32).
 * Host action: abi.
 * @return The ROSv2 ABI major, or a host error.
 */

/** @fn uint32_t wr_capability_open(uint32_t arg0, uint64_t arg1, uint64_t arg2, uint64_t arg3)
 * @brief Exact existing alias; no grant creation or upgrade; undelivered handle rolled back.
 * @details Guest import <tt>uwvm_ros_v2.capability.open</tt>.
 * Wire format: special_signature.
 * Request fields: alias (text).
 * Result fields: capability (u64).
 * Host action: capability.open.
 * @param arg0 Index of the caller's linear memory.
 * @param arg1 Address of the alias text.
 * @param arg2 Length of the alias in bytes.
 * @param arg3 Address of the resulting 64-bit capability handle.
 * @return The ROSv2 status code. Interpret response fields according to the operation contract.
 */

/** @fn uint32_t wr_capability_close(uint64_t arg0)
 * @brief Close capability handle without resetting budgets or resource lifetime.
 * @details Guest import <tt>uwvm_ros_v2.capability.close</tt>.
 * Wire format: special_signature.
 * Request fields: capability (u64).
 * Result fields: none.
 * Host action: capability.close.
 * @param arg0 Live capability handle owned by this caller.
 * @return The ROSv2 status code. Interpret response fields according to the operation contract.
 */

